module Main exposing (main)

import Meta
import Node
import ChildProcess
import Terminal.Parser as CliParser
import Terminal.PackageInstall
import Terminal.PackageUninstall
import Terminal.PackageOutdated
import Terminal.PackageBump
import Terminal.PackageDiff
import Terminal.PackageValidate
import Terminal.Paths
import Terminal.Init
import Terminal.Run
import Terminal.Help
import Terminal.Repl
import Cli.Report as Report exposing (Report)
import Terminal.Format
import Terminal.Protobuf
import Compiler.Backend
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.Paths
import Compiler.Outline as Outline exposing (Outline)
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Git
import Stream
import Stream.Log
import Task exposing (Task)
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Bytes exposing (Bytes)
import Terminal
import Cli.Parser
import Cli.PrettyPrinter as PP
import SemanticVersion exposing (SemanticVersion)
import Json.Encode as Json


{-| The front end is a task (D72): it reads its environment, does what the
arguments ask, and ends with the status that answers, once standard output and
error are written through. It was a `Node.defineProgram` whose messages only
ever carried the next command (geng-lang `m1b-source.md` §SO18).
-}
main : Task Never {}
main =
    Node.getEnvironment
        |> Task.andThen start
        |> Task.andThen Node.setExitCode


type alias Context =
    { args : Array String
    , stdout : Stream.Writable Bytes
    , stderr : Stream.Writable Bytes
    , stdin : Stream.Readable Bytes
    , useColor : Bool
    , interactive : Bool
    , cacheRoot : Compiler.Paths.CacheRoot
    , backendPath : Path
    , fsPermission : FileSystem.Permission
    , cpPermission : ChildProcess.Permission
    , pathToString : Path -> String
    }


start : Node.Environment -> Task Never Int
start env =
    Task.await FileSystem.initialize <| \fsPermission ->
    Task.await ChildProcess.initialize <| \cpPermission ->
    Task.await Terminal.initialize <| \terminalConfig ->
    Task.await Node.getEnvironmentVariables <| \envVars ->
    Task.await (FileSystem.homeDirectory fsPermission) <| \homeDir ->
        let
            interactiveTerminal =
                terminalConfig /= Nothing

            cacheRoot =
                Compiler.Paths.cacheRoot env.platform envVars homeDir Meta.version

            -- Stock downloads its backend from gren-lang's releases. That
            -- binary is stock Gren, never this compiler's backend, and saving
            -- it under `geng` is the confusion D174 renamed the command to
            -- end. So nothing is downloaded: the backend is `GENG_BIN`, or one
            -- already put at the cache path.
            backendPath =
                when { platform = env.platform, override = Dict.get "GENG_BIN" envVars } is
                    { override = Just overridePath, platform = Node.Win32 } ->
                        Path.fromWin32String overridePath

                    { override = Just overridePath } ->
                        Path.fromPosixString overridePath

                    _ ->
                        Compiler.Paths.backendBinary env.platform cacheRoot

            context =
                { args = Array.dropFirst 2 env.args
                , stdout = env.stdout
                , stderr = env.stderr
                , stdin = env.stdin
                , interactive = interactiveTerminal
                , useColor = interactiveTerminal && not (Dict.member "NO_COLOR" envVars)
                , cacheRoot = cacheRoot
                , backendPath = backendPath
                , fsPermission = fsPermission
                , cpPermission = cpPermission
                , pathToString =
                    if env.platform == Node.Win32 then
                        Path.toWin32String
                    else
                        Path.toPosixString
                }
        in
        FileSystem.checkAccess fsPermission [] backendPath
            |> Task.andThen (parseUserArgs context)
            |> Task.onError
                (\_ ->
                    Stream.Log.line context.stderr
                        ("Compiler backend not found at "
                            ++ context.pathToString backendPath
                            ++ ". Set GENG_BIN to the `geng` a build of the compiler produced."
                        )
                        |> Task.map (\_ -> 1)
                )


parseUserArgs : Context -> Path -> Task x Int
parseUserArgs context compilerPath =
    let
        printOpts =
            { useColor = context.useColor
            }

        endWithError prettyErr =
            Report.prettyPrint printOpts prettyErr
                |> endWithErrorString

        endWithErrorString stringErr =
            Stream.Log.string context.stderr stringErr
                |> Task.map (\_ -> 1)

        endWithErrorReport outputType report =
            Report.toString outputType context.pathToString report
                |> endWithErrorString

        succeeded task =
            Task.map (\_ -> 0) task
    in
    when Cli.Parser.run context.args CliParser.parser is
        Cli.Parser.UnknownCommand commandName ->
            endWithErrorString ("I don't recognize this command: " ++ commandName ++ "\n")
    
        Cli.Parser.BadFlags err ->
            err
                |> Cli.Parser.flagErrorPrettified
                |> endWithError
    
        Cli.Parser.BadArguments err ->
            err
                |> Cli.Parser.argumentErrorPrettified
                |> endWithError
    
        Cli.Parser.HelpText prettifiedText ->
            prettifiedText
                |> Report.prettyPrint printOpts
                |> Stream.Log.line context.stdout
                |> succeeded
    
        Cli.Parser.Success parsedCommand ->
            let
                backend backendCommand =
                    startBackend context compilerPath
                        |> Task.andThen
                            (talkToBackend context
                                { headless = False
                                , encodedCommand =
                                    Compiler.Backend.encodeCommand
                                        { interactiveSession = context.interactive
                                        , pathToString = context.pathToString
                                        }
                                        backendCommand
                                }
                            )
            in
            when parsedCommand is
                CliParser.Init flags ->
                    Terminal.Init.run
                        { fsPermission = context.fsPermission
                        , cpPermission = context.cpPermission
                        , cacheRoot = context.cacheRoot
                        , stdout = context.stdout
                        , stdin = context.stdin
                        , interactive = context.interactive
                        , useColor = context.useColor
                        , package = flags.package
                        , platform = flags.platform
                        }
                        |> succeeded
                        |> Task.mapError Terminal.Init.prettifyError
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.Repl flags ->
                    Terminal.PackageInstall.readProjectOutline context.fsPermission
                        |> Task.onError
                            (\err ->
                                when err is
                                    Terminal.PackageInstall.ReadProjectOutlineNoProject _ ->
                                        Terminal.Repl.setupGlobalReplProject
                                            { stdout = context.stdout
                                            , stdin = context.stdin
                                            , fsPermission = context.fsPermission
                                            , cpPermission = context.cpPermission
                                            , cacheRoot = context.cacheRoot
                                            , useColor = context.useColor
                                            }
                                            |> Task.mapError Terminal.Repl.prettifyError

                                    _ ->
                                        Task.fail err
                                            |> Task.mapError Terminal.PackageInstall.prettifyProjectOutlineError
                            )
                        |> Task.andThen
                            (\projectOutline ->
                                Terminal.PackageInstall.run
                                    { fsPermission = context.fsPermission
                                    , cpPermission = context.cpPermission
                                    , cacheRoot = context.cacheRoot
                                    , interactive = context.interactive
                                    , useColor = context.useColor
                                    , stdout = context.stdout
                                    , stdin = context.stdin
                                    , strictAppResolution = True
                                    }
                                    projectOutline
                                    |> Task.mapError Terminal.PackageInstall.prettifyError
                            )
                        |> Task.andThen
                            (\resolved ->
                                backend <|
                                    Compiler.Backend.Repl
                                        { interpreter = flags.interpreter
                                        , projectPath = resolved.projectPath
                                        , outline = resolved.outline
                                        , rootSources = resolved.rootSources
                                        , dependencies = resolved.dependencies
                                        }
                            )
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.Make flags ->
                    let
                        determineOutputStreamForResolve =
                            when flags.output is
                                Just Compiler.Backend.StdOut ->
                                    -- We only want to print the actual generated JS
                                    -- in this case, ignoring everything else
                                    Terminal.Help.getNullStream
                                        |> Task.map Stream.writable

                                _ ->
                                    Task.succeed context.stdout

                        reportType =
                            when flags.report is
                                Just {} ->
                                    Report.Json

                                Nothing ->
                                    Report.Terminal printOpts
                    in
                    determineOutputStreamForResolve
                        |> Task.andThen (\output -> resolveProject { context | stdout = output })
                        |> Task.andThen (verifyMakeFlags context.fsPermission flags.entryPoints flags.output)
                        |> Task.andThen
                            (\resolved ->
                                backend <|
                                    Compiler.Backend.Make
                                        { optimize = flags.optimize
                                        , sourcemaps = flags.sourcemaps
                                        , output = flags.output
                                        , report = flags.report
                                        , projectPath = resolved.projectPath
                                        , entryPoints = flags.entryPoints
                                        , outline = resolved.outline
                                        , rootSources = resolved.rootSources
                                        , dependencies = resolved.dependencies
                                        }
                            )
                        |> Task.onError (endWithErrorReport reportType)

                CliParser.Run opts ->
                    Terminal.Run.make
                        { fsPermission = context.fsPermission
                        , cpPermission = context.cpPermission
                        , cacheRoot = context.cacheRoot
                        , useColor = context.useColor
                        , compilerPath = compilerPath
                        , pathToString = context.pathToString
                        , moduleName = opts.moduleName
                        , package = opts.package
                        }
                        |> Task.andThen
                            (\compiling ->
                                talkToBackend context
                                    { headless = True
                                    , encodedCommand = compiling.encodedCommand
                                    }
                                    compiling.backend
                                    |> Task.andThen
                                        (\exitCode ->
                                            if exitCode == 0 then
                                                Terminal.Run.run
                                                    { cpPermission = context.cpPermission
                                                    , fsPermission = context.fsPermission
                                                    , pathToString = context.pathToString
                                                    , path = compiling.outputPath
                                                    }

                                            else
                                                Task.succeed exitCode
                                        )
                            )
                        |> Task.mapError Terminal.Run.prettifyError
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.Docs flags ->
                    let
                        determineOutputStreamForResolve =
                            when flags.output is
                                Just Compiler.Backend.DocsStdOut ->
                                    -- We only want to print the actual generated JS
                                    -- in this case, ignoring everything else
                                    Terminal.Help.getNullStream
                                        |> Task.map Stream.writable

                                _ ->
                                    Task.succeed context.stdout

                        reportType =
                            when flags.report is
                                Just {} ->
                                    Report.Json

                                Nothing ->
                                    Report.Terminal printOpts
                    in
                    determineOutputStreamForResolve
                        |> Task.andThen (\output -> resolveProject { context | stdout = output })
                        |> Task.andThen
                            (\resolved ->
                                backend <|
                                    Compiler.Backend.Docs
                                        { output = flags.output
                                        , report = flags.report
                                        , projectPath = resolved.projectPath
                                        , outline = resolved.outline
                                        , rootSources = resolved.rootSources
                                        , dependencies = resolved.dependencies
                                        }
                            )
                        |> Task.onError (endWithErrorReport reportType)

                CliParser.PackageInstall Nothing ->
                    resolveProject context
                        |> Task.andThen
                            (\res ->
                                Terminal.PackageInstall.cleanPackageDirectory context.fsPermission res
                                    |> Task.mapError (\_ -> Report.empty)
                            )
                        |> succeeded
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.PackageInstall (Just requestedPackage) ->
                    Terminal.PackageInstall.readProjectOutline context.fsPermission
                        |> Task.mapError Terminal.PackageInstall.prettifyProjectOutlineError
                        |> Task.andThen
                            (\projectOutline ->
                                Terminal.PackageInstall.addPackage
                                    { fsPermission = context.fsPermission
                                    , cpPermission = context.cpPermission
                                    , cacheRoot = context.cacheRoot
                                    , interactive = context.interactive
                                    , useColor = context.useColor
                                    , stdout = context.stdout
                                    , stdin = context.stdin
                                    , strictAppResolution = True
                                    }
                                    projectOutline
                                    requestedPackage
                                    |> Task.mapError Terminal.PackageInstall.prettifyAddPackageError
                            )
                        |> succeeded
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.PackageUninstall packageName ->
                    Terminal.PackageInstall.readProjectOutline context.fsPermission
                        |> Task.mapError Terminal.PackageInstall.prettifyProjectOutlineError
                        |> Task.andThen
                            (\projectOutline ->
                                Terminal.PackageUninstall.run
                                    { fsPermission = context.fsPermission
                                    , cpPermission = context.cpPermission
                                    , cacheRoot = context.cacheRoot
                                    , interactive = context.interactive
                                    , useColor = context.useColor
                                    , stdout = context.stdout
                                    , stdin = context.stdin
                                    }
                                    projectOutline
                                    packageName
                                    |> Task.mapError Terminal.PackageUninstall.prettifyError
                                    |> Task.andThen
                                        (\res ->
                                            Terminal.PackageInstall.cleanPackageDirectory context.fsPermission res
                                                |> Task.mapError (\_ -> Report.empty)
                                        )
                            )
                        |> succeeded
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.PackageOutdated ->
                    Terminal.PackageInstall.readProjectOutline context.fsPermission
                        |> Task.mapError Terminal.PackageInstall.prettifyProjectOutlineError
                        |> Task.andThen
                            (\projectOutline ->
                                Terminal.PackageOutdated.run
                                    { fsPermission = context.fsPermission
                                    , cpPermission = context.cpPermission
                                    , interactive = context.interactive
                                    , useColor = context.useColor
                                    , stdout = context.stdout
                                    , stdin = context.stdin
                                    }
                                    projectOutline
                                    |> Task.mapError Terminal.PackageOutdated.prettifyError
                            )
                        |> succeeded
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.PackageValidate ->
                    Terminal.PackageInstall.readProjectOutline context.fsPermission
                        |> Task.mapError Terminal.PackageInstall.prettifyProjectOutlineError
                        |> Task.andThen
                            (\projectOutline ->
                                Terminal.PackageValidate.run
                                    { fsPermission = context.fsPermission
                                    , cpPermission = context.cpPermission
                                    , cacheRoot = context.cacheRoot
                                    , interactive = context.interactive
                                    , useColor = context.useColor
                                    , stdout = context.stdout
                                    , stdin = context.stdin
                                    }
                                    projectOutline
                                    |> Task.mapError Terminal.PackageValidate.prettifyError
                            )
                        |> Task.andThen (\backendFlags -> backend (Compiler.Backend.PackageValidate backendFlags))
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.PackageBump ->
                    Terminal.PackageInstall.readProjectOutline context.fsPermission
                        |> Task.mapError Terminal.PackageInstall.prettifyProjectOutlineError
                        |> Task.andThen
                            (\projectOutline ->
                                Terminal.PackageBump.run
                                    { fsPermission = context.fsPermission
                                    , cpPermission = context.cpPermission
                                    , cacheRoot = context.cacheRoot
                                    , interactive = context.interactive
                                    , useColor = context.useColor
                                    , stdout = context.stdout
                                    , stdin = context.stdin
                                    }
                                    projectOutline
                                    |> Task.mapError Terminal.PackageBump.prettifyError
                            )
                        |> Task.andThen (\backendFlags -> backend (Compiler.Backend.PackageBump backendFlags))
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.PackageDiff args ->
                    let
                        diffTask =
                            when args is
                                CliParser.DiffLatest ->
                                    Terminal.PackageDiff.runLocal
                                        { fsPermission = context.fsPermission
                                        , cpPermission = context.cpPermission
                                        , cacheRoot = context.cacheRoot
                                        , interactive = context.interactive
                                        , useColor = context.useColor
                                        , stdout = context.stdout
                                        , stdin = context.stdin
                                        }
                                        Nothing
                                        |> Task.mapError Terminal.PackageDiff.prettifyLocalError

                                CliParser.DiffVersion version ->
                                    Terminal.PackageDiff.runLocal
                                        { fsPermission = context.fsPermission
                                        , cpPermission = context.cpPermission
                                        , cacheRoot = context.cacheRoot
                                        , interactive = context.interactive
                                        , useColor = context.useColor
                                        , stdout = context.stdout
                                        , stdin = context.stdin
                                        }
                                        (Just version)
                                        |> Task.mapError Terminal.PackageDiff.prettifyLocalError

                                CliParser.DiffRange { lower, upper } ->
                                    Terminal.PackageInstall.readProjectOutline context.fsPermission
                                        |> Task.mapError Terminal.PackageInstall.prettifyProjectOutlineError
                                        |> Task.andThen
                                            (\{ outline } ->
                                                when outline is
                                                    Outline.App _ ->
                                                        -- TODO
                                                        Terminal.PackageDiff.LocalCannotDiffApplication
                                                            |> Terminal.PackageDiff.prettifyLocalError 
                                                            |> Task.fail

                                                    Outline.Pkg pkgOutline ->
                                                        Terminal.PackageDiff.runGlobal
                                                            { fsPermission = context.fsPermission
                                                            , cpPermission = context.cpPermission
                                                            , cacheRoot = context.cacheRoot
                                                            , interactive = context.interactive
                                                            , useColor = context.useColor
                                                            , stdout = context.stdout
                                                            , stdin = context.stdin
                                                            }
                                                            pkgOutline.name
                                                            lower
                                                            upper
                                                            |> Task.mapError Terminal.PackageDiff.prettifyGlobalError
                                            )

                                CliParser.DiffGlobal { package, lower, upper } ->
                                    Terminal.PackageDiff.runGlobal
                                        { fsPermission = context.fsPermission
                                        , cpPermission = context.cpPermission
                                        , cacheRoot = context.cacheRoot
                                        , interactive = context.interactive
                                        , useColor = context.useColor
                                        , stdout = context.stdout
                                        , stdin = context.stdin
                                        }
                                        package
                                        lower
                                        upper
                                        |> Task.mapError Terminal.PackageDiff.prettifyGlobalError
                    in
                    diffTask
                        |> Task.andThen (\backendFlags -> backend (Compiler.Backend.PackageDiff backendFlags))
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))

                CliParser.Paths opts ->
                    Terminal.Paths.run
                        { fsPermission = context.fsPermission
                        , stdout = context.stdout
                        , pathToString = context.pathToString
                        , cacheRoot = context.cacheRoot
                        , backendPath = context.backendPath
                        }
                        opts
                        |> succeeded
                        |> Task.mapError Terminal.Paths.errorToString
                        |> Task.onError endWithErrorString

                CliParser.Protobuf protobufFlags ->
                    Terminal.Protobuf.run
                        { fsPermission = context.fsPermission
                        , pathToString = context.pathToString
                        , paths = protobufFlags.paths
                        , describe = protobufFlags.describe
                        , protoPath = protobufFlags.protoPath
                        , output = protobufFlags.output
                        }
                        |> Task.andThen (Stream.Log.string context.stdout)
                        |> succeeded
                        |> Task.onError endWithErrorString

                CliParser.Format formatFlags ->
                    -- Only the no-argument form is a question about a project;
                    -- `geng fmt Some/File.gren` must work wherever the file is.
                    (if formatFlags.paths == [] then
                        Terminal.PackageInstall.readProjectOutline context.fsPermission
                            |> Task.mapError Terminal.PackageInstall.prettifyProjectOutlineError
                            |> Task.map Terminal.Format.Project

                     else
                        Task.succeed (Terminal.Format.Paths formatFlags.paths)
                    )
                        |> Task.andThen
                            (\sources ->
                                Terminal.Format.run
                                    { stdout = context.stdout
                                    , fsPermission = context.fsPermission
                                    , pathToString = context.pathToString
                                    , sources = sources
                                    , check = formatFlags.check
                                    }
                                    |> Task.mapError Terminal.Format.prettifyError
                            )
                        |> Task.andThen (Stream.Log.line context.stdout)
                        |> succeeded
                        |> Task.onError (endWithErrorReport (Report.Terminal printOpts))


startBackend : Context -> Path -> Task Report ChildProcess.Child
startBackend context compilerPath =
    Compiler.Backend.run
        context.cpPermission
        { useColor = context.useColor
        , compilerPath = compilerPath
        , pathToString = context.pathToString
        }
        |> Task.mapError
            (\err ->
                Report.create
                    "CANNOT START THE COMPILER BACKEND"
                    Nothing
                    (PP.words ("I could not start " ++ err.program ++ ": " ++ err.errorCode))
            )


{-| Hand the backend its command, and answer its exit status once it has exited
and everything it wrote has been passed on.

Its standard output and error are copied to ours until each closes, and
`waitForExit` answers when it exits, so those three run concurrently and all of
them end. Our standard input is copied to the backend's for as long as the
backend runs, which is what the REPL reads. That copy ends only when our input
closes, and at a terminal it never does, so it races the backend's exit, and
losing cancels it (D109).

The program this replaced sent itself a message per chunk and exited the moment
the backend did, which could land before the backend's last output had been
read. `headless` is `geng run`'s compile, whose output is not ours to show and
which reads no input.
-}
talkToBackend : Context -> { headless : Bool, encodedCommand : Bytes } -> ChildProcess.Child -> Task x Int
talkToBackend context { headless, encodedCommand } child =
    let
        exited =
            ChildProcess.waitForExit child
    in
    when ChildProcess.streams child is
        Nothing ->
            exited

        Just streams ->
            let
                input =
                    Stream.write encodedCommand streams.input
                        |> Task.andThen
                            (\_ ->
                                if headless then
                                    Task.succeed {}

                                else
                                    copy context.stdin streams.input
                            )
                        |> Task.andThen (\_ -> Task.map (\_ -> {}) exited)
            in
            Task.concurrent
                [ Task.race input [ Task.map (\_ -> {}) exited ]
                , if headless then
                    Task.succeed {}

                  else
                    copy streams.output context.stdout
                , copy streams.error context.stderr
                ]
                |> Task.andThen (\_ -> exited)
                |> Task.onError
                    (\error ->
                        Stream.Log.line context.stderr ("Something went wrong when communicating with compiler backend: " ++ Stream.errorToString error)
                            |> Task.map (\_ -> 1)
                    )


{-| Copy chunks from `source` to `target` until `source` closes.
-}
copy : Stream.Readable Bytes -> Stream.Writable Bytes -> Task Stream.Error {}
copy source target =
    Stream.read source
        |> Task.map Just
        |> Task.onError
            (\error ->
                when error is
                    Stream.Closed ->
                        Task.succeed Nothing

                    _ ->
                        Task.fail error
            )
        |> Task.andThen
            (\chunk ->
                when chunk is
                    Just bytes ->
                        Stream.write bytes target
                            |> Task.andThen (\_ -> copy source target)

                    Nothing ->
                        Task.succeed {}
            )


resolveProject : Context -> Task Report Terminal.PackageInstall.PackageResolution
resolveProject context =
    Terminal.PackageInstall.readProjectOutline context.fsPermission
        |> Task.mapError Terminal.PackageInstall.prettifyProjectOutlineError
        |> Task.andThen
            (\projectOutline ->
                Terminal.PackageInstall.run
                    { fsPermission = context.fsPermission
                    , cpPermission = context.cpPermission
                    , cacheRoot = context.cacheRoot
                    , interactive = context.interactive
                    , useColor = context.useColor
                    , stdout = context.stdout
                    , stdin = context.stdin
                    , strictAppResolution = True
                    }
                    projectOutline
                    |> Task.mapError Terminal.PackageInstall.prettifyError
            )


-- TODO: Move to gren-lang/compiler-node
verifyMakeFlags : FileSystem.Permission -> Array ModuleName -> Maybe Compiler.Backend.MakeOutput -> Terminal.PackageInstall.PackageResolution -> Task Report Terminal.PackageInstall.PackageResolution
verifyMakeFlags fsPermission entryPoints maybeOutput resolution =
    let
        maybeOutputPath =
            when maybeOutput is
                Nothing ->
                    Nothing

                Just Compiler.Backend.StdOut ->
                    Nothing
                    
                Just Compiler.Backend.DevNull ->
                    Nothing

                Just (Compiler.Backend.Html strPath) ->
                    Just strPath

                Just (Compiler.Backend.Js strPath) ->
                    Just strPath

                Just (Compiler.Backend.Exe strPath) ->
                    Just strPath

        compatibleOutputCheck =
            when maybeOutputPath is
                Nothing ->
                    Task.succeed {}

                Just strPath ->
                    Node.getPlatform
                        |> Task.map
                            (\platform ->
                                when platform is
                                    Node.Win32 ->
                                        Path.fromWin32String strPath

                                    _ ->
                                        Path.fromPosixString strPath
                            )
                        |> Task.andThen
                            (\path ->
                                FileSystem.metadata fsPermission { resolveLink = False } path
                                    |> Task.map Just
                                    |> Task.onError
                                        (\fsError ->
                                            if FileSystem.errorIsNoSuchFileOrDirectory fsError then
                                                Task.succeed Nothing

                                            else
                                                Task.fail <|
                                                    Report.create
                                                        "CANNOT ACCESS OUTPUT PATH"
                                                        (Just path)
                                                        (PP.verticalBlock
                                                            [ PP.words
                                                                ( "You have told me to compile this project to "
                                                                    ++ Path.toPosixString path
                                                                    ++ ", but I cannot access this path for some reason!"
                                                                )
                                                            ]
                                                        )
                                        )
                                    |> Task.andThen
                                        (\maybeMeta ->
                                            when maybeMeta is
                                                Nothing ->
                                                    Task.succeed {}

                                                Just metadata ->
                                                    if metadata.entityType == FileSystem.Directory then
                                                        Report.create
                                                            "OUTPUT PATH IS A DIRECTORY"
                                                            (Just path)
                                                            (PP.verticalBlock
                                                                [ PP.words
                                                                    ( "You have told me to compile this project to "
                                                                        ++ Path.toPosixString path
                                                                        ++ ", but this is a directory!"
                                                                    )
                                                                ]
                                                            )
                                                            |> Task.fail

                                                    else
                                                        Task.succeed {}
                                        )
                                )
    in
    compatibleOutputCheck
        |> Task.andThen
            (\{} ->
                when Array.findFirst (\moduleName -> not <| Dict.member (ModuleName.toString moduleName) resolution.rootSources) entryPoints is
                    Nothing ->
                        Task.succeed resolution

                    Just { value = moduleName } ->
                        Task.fail <|
                            Report.create
                                "MODULE DOES NOT EXIST"
                                Nothing
                                (PP.verticalBlock
                                    [ PP.words
                                        ( "You have told me to compile "
                                            ++ ModuleName.toString moduleName
                                            ++ ", but this module isn't defined in this project!"
                                        )
                                    ]
                                )
            )
