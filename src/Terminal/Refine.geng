module Terminal.Refine exposing (Config, Sources, build, sourcesOf)

{-| A build checked by the refinement checker (geng-lang `m4-refine.md`
§RF24, D833).

The checker is a Geng package (D826), so it runs here, between two runs of
the compiler binary. The first is asked with `GENG_REFINE_STAGE` naming a
temporary directory: a program with a refinement in any of its modules stops
there with every module's Core written and nothing else, and one with none is
built as it always was. When it stopped, the checker walks the Core, and a
goal it could not prove refuses the program with each such goal on its own
line. Otherwise the binary is run again with `GENG_REFINE_CHECKED`, and that
run is the build. The directory is removed either way.

`GENG_REFINE_REPORT` names a file for every goal's line, proved or not, which
is what `harness/refine.py` pins. `GENG_UNCHECKED_REFINEMENTS` lets a program
whose goals are not all proved build anyway (D825): a development switch, so
that the gate can report on cases written to be refused.

Each goal that refuses the program is an error of its own (geng-lang
`m4-refine.md` §RF26, D811): its title, its module's path, and
`Geng.Refine.Error`'s blocks, with an excerpt of the source the build read,
which is the source this CLI sent the binary (D840). `GENG_REFINE_ERRORS`
names a file for the errors' text, without colour, whether or not they refuse
the program, which is what `harness/refine.py` pins beside the report.

`GENG_REFINE_QUERIES` names a file for every question the checker put to its
solver, as SMT-LIB with the solver's verdict, which `harness/oracle.py` puts
to Z3 (§RF25, D803); `GENG_REFINE_EVERY_MODULE` has the checker walk every
module of the program, so that the questions `core`'s loops raise are among
them.

`core`'s modules are read for their signatures and not checked (§RF27,
D845): `core` is the compiler's, its goals the same in every program, and
`harness/refine.py` holds them. `GENG_REFINE_CORE` checks them too, which is
how the gate does, and `GENG_REFINE_EVERY_MODULE` implies it.
-}

import Bytes
import Cli.PrettyPrinter as PP
import Cli.Report as Report exposing (Report)
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Geng.Core as Core
import Geng.Core.Wire as Wire
import Geng.Refine.Check as Check
import Geng.Refine.Error as Error
import Task exposing (Task)


{-| What a checked build needs: `run` runs the compiler binary once with the
variables given set on top of the build's own, and answers its exit status.
-}
type alias Config =
    { fs : FileSystem.Permission
    , envVars : Dict String String
    , sources : Sources
    , toString : Path -> String
    , fromString : String -> Path
    , run : Dict String String -> Task Report Int
    }


{-| The source the build read: the application's modules by name, each with
its path, and each dependency's, by package, under its root.
-}
type alias Sources =
    { projectPath : Path
    , root : Dict String { path : Path, data : String }
    , dependencies : Dict String { path : Path, sources : Dict String String }
    }


{-| A package resolution's sources, which every checked build has. -}
sourcesOf :
    { r
        | projectPath : Path
        , rootSources : Dict String { s | path : Path, data : String }
        , dependencies : Dict String { d | path : Path, sources : Dict String String }
    }
    -> Sources
sourcesOf resolution =
    { projectPath = resolution.projectPath
    , root = Dict.map (\_ file -> { path = file.path, data = file.data }) resolution.rootSources
    , dependencies = Dict.map (\_ dep -> { path = dep.path, sources = dep.sources }) resolution.dependencies
    }


build : Config -> Task Report Int
build config =
    FileSystem.makeTempDirectory config.fs "geng-refine-"
        |> Task.mapError (\e -> failure "I cannot make a directory for the refinement checker" (FileSystem.errorToString e))
        |> Task.andThen
            (\dir ->
                config.run (Dict.singleton "GENG_REFINE_STAGE" (config.toString dir))
                    |> Task.andThen
                        (\exitCode ->
                            if exitCode /= 0 then
                                Task.succeed exitCode

                            else
                                readModules config.fs dir
                                    |> Task.andThen (checked config)
                        )
                    |> Task.andThen (\exitCode -> remove config dir |> Task.map (\_ -> exitCode))
                    |> Task.onError (\report -> remove config dir |> Task.andThen (\_ -> Task.fail report))
            )


{-| After a first run that succeeded: the build it was, when it wrote no Core;
otherwise the check, and the second run or the refusal.
-}
checked : Config -> Array Core.Module -> Task Report Int
checked config modules =
    if Array.isEmpty modules then
        Task.succeed 0

    else
        let
            checkedRun =
                Check.checkWith
                    { recording = Dict.member "GENG_REFINE_QUERIES" config.envVars
                    , everyModule = Dict.member "GENG_REFINE_EVERY_MODULE" config.envVars
                    }
                    (\name -> withCore || name.package /= "core")
                    modules

            withCore =
                Dict.member "GENG_REFINE_CORE" config.envVars
                    || Dict.member "GENG_REFINE_EVERY_MODULE" config.envVars

            goals =
                checkedRun.goals

            refusing =
                Check.refused goals
        in
        writeReport config goals
            |> Task.andThen (\_ -> writeQueries config checkedRun.queries)
            |> Task.andThen (\_ -> writeErrors config refusing)
            |> Task.andThen
                (\_ ->
                    if Array.isEmpty refusing || Dict.member "GENG_UNCHECKED_REFINEMENTS" config.envVars then
                        config.run (Dict.singleton "GENG_REFINE_CHECKED" "1")

                    else
                        Task.fail (refusal config refusing)
                )


writeReport : Config -> Array Check.Goal -> Task Report {}
writeReport config goals =
    when Dict.get "GENG_REFINE_REPORT" config.envVars is
        Just out ->
            FileSystem.writeFile config.fs (Bytes.fromString (Check.render goals)) (config.fromString out)
                |> Task.map (\_ -> {})
                |> Task.mapError (\e -> failure "I cannot write the refinement report" (FileSystem.errorToString e))

        Nothing ->
            Task.succeed {}


writeQueries : Config -> Array Check.Query -> Task Report {}
writeQueries config queries =
    when Dict.get "GENG_REFINE_QUERIES" config.envVars is
        Just out ->
            FileSystem.writeFile config.fs (Bytes.fromString (Check.renderQueries queries)) (config.fromString out)
                |> Task.map (\_ -> {})
                |> Task.mapError (\e -> failure "I cannot write the refinement queries" (FileSystem.errorToString e))

        Nothing ->
            Task.succeed {}


writeErrors : Config -> Array Check.Goal -> Task Report {}
writeErrors config goals =
    when Dict.get "GENG_REFINE_ERRORS" config.envVars is
        Just out ->
            let
                text =
                    if Array.isEmpty goals then
                        ""

                    else
                        Report.toString (Report.Terminal { useColor = False }) config.toString (refusal config goals)
            in
            FileSystem.writeFile config.fs (Bytes.fromString text) (config.fromString out)
                |> Task.map (\_ -> {})
                |> Task.mapError (\e -> failure "I cannot write the refinement errors" (FileSystem.errorToString e))

        Nothing ->
            Task.succeed {}


{-| The refusal (D811): each goal not proved as an error of its own, the
first as the report and each after it under a bar of its own, drawn as
`Cli.Report` draws one, so that the report stays one report for `--report`.
-}
refusal : Config -> Array Check.Goal -> Report
refusal config goals =
    let
        errors =
            Array.map
                (\goal ->
                    let
                        found =
                            locate config.sources goal
                    in
                    { error = Error.fromGoal (Maybe.map .data found) goal
                    , path = Maybe.map .path found
                    }
                )
                goals

        later =
            Array.dropFirst 1 errors
                |> Array.mapAndFlatten
                    (\e ->
                        [ PP.empty
                        , PP.empty
                        , bar config e.error.title e.path
                        , PP.empty
                        , message e.error
                        ]
                    )
    in
    when Array.first errors is
        Just first ->
            Report.create first.error.title first.path (PP.verticalBlock (Array.pushFirst (message first.error) later))

        Nothing ->
            Report.empty


message : Error.Error -> PP.Document
message error =
    error.blocks
        |> Array.map
            (\block ->
                when block is
                    Error.Prose text ->
                        PP.words text

                    Error.Code lines ->
                        PP.verticalBlock (Array.map PP.text lines)
            )
        |> Array.intersperse PP.empty
        |> PP.verticalBlock


{-| A report's bar, `-- TITLE ---- path`, as `Cli.Report` draws it. -}
bar : Config -> String -> Maybe Path -> PP.Document
bar config title maybePath =
    let
        dashes n =
            String.repeat (max 1 (80 - n)) "-"

        end =
            when maybePath is
                Nothing ->
                    " " ++ dashes (5 + String.count title)

                Just path ->
                    let
                        written =
                            config.toString path
                    in
                    " " ++ dashes (5 + String.count title + String.count written) ++ " " ++ written
    in
    PP.block [ PP.text "-- ", PP.text title, PP.text end ]
        |> PP.color PP.Cyan


{-| A goal's module's source and its path, the application's relative to the
project: a dependency's when the goal's package is one, the application's
otherwise.
-}
locate : Sources -> Check.Goal -> Maybe { path : Path, data : String }
locate sources goal =
    when Dict.get goal.package sources.dependencies is
        Just dep ->
            Dict.get goal.module_ dep.sources
                |> Maybe.map
                    (\data ->
                        { path = Path.append (Path.fromPosixString ("src/" ++ String.replace "." "/" goal.module_ ++ ".geng")) dep.path
                        , data = data
                        }
                    )

        Nothing ->
            Dict.get goal.module_ sources.root
                |> Maybe.map (\file -> { path = relativeTo sources.projectPath file.path, data = file.data })


relativeTo : Path -> Path -> Path
relativeTo root path =
    let
        rootText =
            Path.toPosixString root

        pathText =
            Path.toPosixString path
    in
    if rootText /= "" && String.startsWith (rootText ++ "/") pathText then
        Path.fromPosixString (String.dropFirst (String.count rootText + 1) pathText)

    else
        path


readModules : FileSystem.Permission -> Path -> Task Report (Array Core.Module)
readModules fs directory =
    let
        cannot e =
            failure "I cannot read the Core the build wrote" (FileSystem.errorToString e)
    in
    FileSystem.listDirectory fs directory
        |> Task.mapError cannot
        |> Task.andThen
            (\entries ->
                entries
                    |> Array.map (\entry -> Path.filenameWithExtension entry.path)
                    |> Array.keepIf (String.endsWith ".corepb")
                    |> Array.sort
                    |> Array.map
                        (\name ->
                            FileSystem.readFile fs (Path.append (Path.fromPosixString name) directory)
                                |> Task.mapError cannot
                                |> Task.andThen
                                    (\data ->
                                        when Wire.read data is
                                            Ok m ->
                                                Task.succeed m

                                            Err e ->
                                                Task.fail (failure ("I cannot read " ++ name) (Wire.errorToString e))
                                    )
                        )
                    |> Task.sequence
            )


remove : Config -> Path -> Task Report {}
remove config dir =
    FileSystem.remove config.fs { recursive = True } dir
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


failure : String -> String -> Report
failure what why =
    Report.create
        "CANNOT CHECK REFINEMENTS"
        Nothing
        (PP.verticalBlock
            [ PP.words (what ++ ":")
            , PP.empty
            , PP.words why
            ]
        )
