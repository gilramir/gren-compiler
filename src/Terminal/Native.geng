module Terminal.Native exposing
    ( Config
    , Linked
    , Plan
    , abandon
    , build
    , isTarget
    , plan
    , prepare
    , requireProgram
    , serve
    , sourceMaps
    , stageEnvironment
    , toolchain
    )

{-| The native half of `geng make`, for a project whose outline says
`target = "native"` (geng-lang `m3-native.md` §NA25).

`Terminal.Beam`'s shape, smaller. The backend is `packages/c-backend`, a Geng
package this front end imports (D491), so a native build is this process running
the binary with `GENG_STAGE_WRITE=passed:dir`, then:

    <output>.native-build/program.c     linked, lowered and printed
    <output>.native-build/geng*.{c,h}   the runtime, which this compiler carries
    <output>                            the C compiler over those and each
                                        package's src/Ext/*.c, with Boehm

where the C is written by a worker thread with a stack of its own, since the
backend recurses once for each level of the Core it reads (geng-lang D645,
`Terminal.BackendWorker`); and the scratch directory goes when the build
succeeds, unless the build asked for debug information (`--debug-info`, D512),
which compiles with `-g` and keeps the directory, less the stage, since it
holds the C and the runtime's sources a debugger shows for the frames that are
not Geng's (§NA30).

**The debug information names real files whatever the flags** (D513). The C's
`#line`s name a Geng module by its package and path, as C5 keeps them
(`app/Main.geng`, `core/Basics.geng`), and the compile maps each of those to
the file on this machine with `-ffile-prefix-map`: the project's modules by the
source directory most of them are in and any other by its own path (D646), and
every package by its `src/`, each ending in `/` since the map is a plain prefix
of the name. So the C is the same on every machine and
only the command line carries this one's paths. The program is
compiled with D490's flags, `-ffp-contract=off -fno-fast-math
-fstack-clash-protection` whatever else is asked, at `-O2` for `geng make` and
`-O0` for `geng run`, whose build is scratch and is run once (§NA28), and with
`NIX_HARDENING_ENABLE` empty so that nixpkgs' compiler wrapper adds nothing to
them (D500).

**The C compiler is the machine's**, found as `Terminal.Beam` finds `erlc`
(D390): `GENG_CC`, then `clang` on `PATH` (D496). `GENG_CFLAGS` is added to its
command line, split on spaces. It comes after the optimization level, so an
`-O` in it is the one the compiler takes.

**Every build carries its own Boehm** (geng-lang `m3-sweep.md` D644): its
source is carried in this compiler compressed (D627), and is written out and
compiled first, on its own, into an object the program links, so that a
machine needs no Boehm of its own and its configuration is this compiler's.
An executable's is threaded, as the release's configure builds it; its black
list is larger than the release's default, which a deep stack filled (§SW28).

A native build with no `main` is a library, `runtime = "host"` (geng-lang
`m3-embed.md` D619, §EM17). The backend roots it at the values its module
exposes, holds each to what crosses to C, and writes the C each is entered by
and a header. The library's name is the output's file name less a leading
`lib` and everything from its first dot, so `--output=libprobe.so` builds the
library `probe`, whose functions are `probe_init` and the rest, and writes
`probe.h` beside it (D617). Its runtime is the executable's with `geng_embed.c`
beside it, compiled with `GENG_LIBRARY` defined to the name, and its Boehm is
single-threaded and hidden (D616). The library is linked `-z nodelete`,
since the fault handler it installs and the collector's roots point into it
(§EM11), and links nothing but libc and libm, and the libraries its packages
name.

**A package names the C libraries it links** (geng-lang D890, D891). A
package's `geng.toml`, or a native application's, may have a `[native]` table
whose `pkg-config` list names the `pkg-config` modules its `src/Ext/*.c` needs.
That package's C is then compiled on its own, with every flag the rest of the C
has and the modules' `--cflags` after them, and linked as objects; the
modules' `--libs` come after every object and before the runtime's own
libraries, so a linker that drops a library nothing before it needs keeps
them. A package with no such table is compiled with the program, as before.
`pkg-config` is the one on `PATH`, or the one `GENG_PKG_CONFIG` names, and its
search path is the environment's (`PKG_CONFIG_PATH`). A module it does not
know is a report naming the package and the module.

-}

import Bytes
import ChildProcess
import Cli.PrettyPrinter as PP
import Cli.Report as Report exposing (Report)
import Compiler.Backend
import Compiler.Outline as Outline exposing (Outline)
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Geng.C.Build as Build
import Geng.C.Runtime as Runtime
import Json.Decode as Decode
import Json.Encode as Encode
import Stream
import Stream.Log
import Task exposing (Task)
import Terminal.BackendWorker as BackendWorker


{-| Whether this project is built for the `native` target. -}
isTarget : Outline -> Bool
isTarget outline =
    when outline is
        Outline.App app ->
            app.target == "native"

        Outline.Pkg _ ->
            False


{-| Where a native build's things go. -}
type alias Plan =
    { exe : Path
    , work : Path
    , stage : Path
    }


type alias Toolchain =
    { cc : String
    , flags : Array String
    , pkgConfig : String
    }


{-| A package whose `[native]` table names `pkg-config` modules (D890): its
name, which a report gives, its root and the modules. -}
type alias Linked =
    { name : String
    , root : Path
    , modules : Array String
    }


type alias Config =
    { fs : FileSystem.Permission
    , cp : ChildProcess.Permission
    , stderr : Stream.Writable Bytes.Bytes
    , toString : Path -> String
    , tools : Toolchain
    , optimization : String
    , debugInfo : Bool
    , packages : Array Path
    , linked : Array Linked
    , sources : Array { name : String, path : String }
    }


{-| What the C's `#line`s name, mapped to the files: the project's modules by
the source directory most of them are in, and each of the others by its own
path, since its source directories are the project's to choose; and a package
by its `src/`. `name` is C5's (`Geng.C.Low.sourceName`), which is `app` for the
project's own modules.

One map for the directory, and not one for each module as D513 had it, because
gcc hands its options to `cc1` in one environment string that Linux refuses
past 128 KB, which a project of 1,024 modules passed (geng-lang `m3-sweep.md`
D646). A module outside that directory is mapped after it, since gcc and clang
both take the last map that matches.
-}
sourceMaps :
    (Path -> String)
    -> { modules : Array { module_ : String, path : Path }, packages : Array { name : String, root : Path } }
    -> Array { name : String, path : String }
sourceMaps toString project =
    let
        located =
            Array.map
                (\m ->
                    let
                        relative =
                            String.join "/" (String.split "." m.module_) ++ ".geng"

                        file =
                            toString m.path
                    in
                    { name = "app/" ++ relative
                    , file = file
                    , directory =
                        if String.endsWith ("/" ++ relative) file then
                            Just (String.dropLast (String.count relative) file)

                        else
                            Nothing
                    }
                )
                project.modules

        mostUsed =
            located
                |> Array.foldl
                    (\m counts ->
                        when m.directory is
                            Just directory ->
                                Dict.update directory (\n -> Just (Maybe.withDefault 0 n + 1)) counts

                            Nothing ->
                                counts
                    )
                    Dict.empty
                |> Dict.foldl
                    (\directory n best ->
                        when best is
                            Just b ->
                                if n > b.n then
                                    Just { directory = directory, n = n }

                                else
                                    best

                            Nothing ->
                                Just { directory = directory, n = n }
                    )
                    Nothing
                |> Maybe.map .directory

        modules =
            when mostUsed is
                Just directory ->
                    Array.pushFirst { name = "app/", path = directory }
                        (located
                            |> Array.keepIf (\m -> m.directory /= Just directory)
                            |> Array.map (\m -> { name = m.name, path = m.file })
                        )

                Nothing ->
                    Array.map (\m -> { name = m.name, path = m.file }) located
    in
    modules
        ++ Array.map
            (\p -> { name = p.name ++ "/", path = toString (Path.append (Path.fromPosixString "src") p.root) ++ "/" })
            project.packages


{-| `GENG_CC`, else `clang`; `GENG_CFLAGS`, split on spaces; and
`GENG_PKG_CONFIG`, else `pkg-config` (D890). -}
toolchain : Dict String String -> Toolchain
toolchain envVars =
    { cc = Maybe.withDefault "clang" (Dict.get "GENG_CC" envVars)
    , pkgConfig = Maybe.withDefault "pkg-config" (Dict.get "GENG_PKG_CONFIG" envVars)
    , flags =
        Dict.get "GENG_CFLAGS" envVars
            |> Maybe.withDefault ""
            |> String.split " "
            |> Array.keepIf (\flag -> flag /= "")
    }


{-| The plan for an `--output`, or why there is none: `/dev/null` asks for no
program, and the three JavaScript artifacts are refused, a native program being
none of them.
-}
plan : (String -> Path) -> Maybe Compiler.Backend.MakeOutput -> Result Report (Maybe Plan)
plan fromString output =
    let
        refuse what instead =
            Err <|
                Report.create
                    "THAT OUTPUT IS NOT A NATIVE PROGRAM"
                    Nothing
                    (PP.verticalBlock
                        [ PP.words ("You have asked for " ++ what ++ ", but this project's target is native.")
                        , PP.empty
                        , PP.words instead
                        ]
                    )
    in
    when output is
        Nothing ->
            Ok (Just (paths (fromString "app")))

        Just (Compiler.Backend.Exe path) ->
            Ok (Just (paths (fromString path)))

        Just Compiler.Backend.StdOut ->
            refuse "the program on standard output" "A native program is an executable file. Give me a file name instead."

        Just (Compiler.Backend.Js path) ->
            refuse ("JavaScript at " ++ path) "Drop the .js from --output and I will write a native program there."

        Just (Compiler.Backend.Html path) ->
            refuse ("an HTML page at " ++ path) "A page needs the js target and the browser platform."

        Just Compiler.Backend.DevNull ->
            Ok Nothing


paths : Path -> Plan
paths exe =
    let
        work =
            Path.append
                (Path.fromPosixString (Path.filenameWithExtension exe ++ ".native-build"))
                (Path.parentPath exe |> Maybe.withDefault Path.empty)
    in
    { exe = exe
    , work = work
    , stage = Path.append (Path.fromPosixString "stage") work
    }


{-| What the compiler binary is run with. `Main.nativeMake` does not get here
when either stage variable is set — for native, a person's `GENG_STAGE_WRITE`
stops the build at the stage, as §NA20 documented — so the refusal below is
for a caller that skips that check. -}
stageEnvironment : (Path -> String) -> Dict String String -> Plan -> Result Report (Dict String String)
stageEnvironment toString envVars thePlan =
    let
        taken name =
            Err <|
                Report.create
                    "THE STAGE IS ALREADY SET"
                    Nothing
                    (PP.verticalBlock
                        [ PP.words (name ++ " is set in this environment, and a build for the native target sets GENG_STAGE_WRITE itself: the backend is not in the compiler binary, so the build stops at the passed Core and finishes here.")
                        , PP.empty
                        , PP.words "Unset it, or build this project for the js target."
                        ]
                    )
    in
    if Dict.member "GENG_STAGE_WRITE" envVars then
        taken "GENG_STAGE_WRITE"

    else if Dict.member "GENG_STAGE_READ" envVars then
        taken "GENG_STAGE_READ"

    else
        Ok (Dict.singleton "GENG_STAGE_WRITE" ("passed:" ++ toString thePlan.stage))


{-| The scratch directory, made afresh. -}
prepare : FileSystem.Permission -> Plan -> Task Report {}
prepare fs thePlan =
    abandon fs thePlan
        |> Task.andThen
            (\_ ->
                FileSystem.makeDirectory fs { recursive = True } thePlan.stage
                    |> Task.mapError (failure "I cannot make the build directory")
            )
        |> Task.map (\_ -> {})


{-| That a `geng run` build left a program to run.

A native build with no `main` is refused before this, so a successful build
leaves no program only when a person's `GENG_STAGE_WRITE` stopped it at the
stage, which a `geng run` then has nothing to run after.
-}
requireProgram : FileSystem.Permission -> Path -> Task Report {}
requireProgram fs path =
    FileSystem.checkAccess fs [] path
        |> Task.map (\_ -> {})
        |> Task.onError
            (\_ ->
                Task.fail <|
                    Report.create
                        "THE BUILD STOPPED AT THE STAGE"
                        Nothing
                        (PP.words "GENG_STAGE_WRITE is set in this environment, so the build stopped at the passed Core and wrote no program for geng run to run. Unset it to run the program.")
            )


{-| The scratch directory, gone. -}
abandon : FileSystem.Permission -> Plan -> Task Report {}
abandon fs thePlan =
    FileSystem.remove fs { recursive = True } thePlan.work
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


{-| The stage directory made a program, and the status that answers. A build
that wrote no stage wrote no program, which `--output=/dev/null` asks for, so a
missing stage is a silent 0.
-}
build : Config -> Plan -> Task Report Int
build config thePlan =
    FileSystem.checkAccess config.fs [] thePlan.stage
        |> Task.map (\_ -> True)
        |> Task.onError (\_ -> Task.succeed False)
        |> Task.andThen
            (\staged ->
                if staged then
                    buildStage config thePlan

                else
                    Task.succeed 0
            )


{-| The backend's part, the stage linked and printed as C, runs on a thread of
its own with a large stack (D645, `Terminal.BackendWorker`): it writes
`program.c` and answers what it printed. -}
buildStage : Config -> Plan -> Task Report Int
buildStage config thePlan =
    BackendWorker.call "backend"
        (Encode.object
            [ { key = "target", value = Encode.string "native" }
            , { key = "exe", value = Encode.string (config.toString thePlan.exe) }
            ]
        )
        printedDecoder
        |> Task.andThen
            (\printed ->
                when printed is
                    Refused why ->
                        Stream.Log.string config.stderr why
                            |> Task.onError (\_ -> Task.succeed {})
                            |> Task.andThen (\_ -> abandon config.fs thePlan)
                            |> Task.map (\_ -> 1)

                    Trouble trouble ->
                        Task.fail (failureText trouble.what trouble.why)

                    Library header ->
                        buildLibrary config thePlan header

                    NoEntry why ->
                        abandon config.fs thePlan
                            |> Task.andThen
                                (\_ ->
                                    Task.fail <|
                                        Report.create
                                            "THIS PROGRAM HAS NOTHING TO RUN"
                                            Nothing
                                            (PP.words ("The backend printed no main for it: " ++ why ++ "."))
                                )

                    Executable ->
                        boehmSources {}
                            |> Task.andThen
                                (\boehm ->
                                    write config.fs thePlan.work Runtime.sources
                                        |> Task.andThen (\_ -> write config.fs (boehmDirectory thePlan) boehm)
                                )
                            |> Task.andThen (\_ -> externSources config)
                            |> Task.andThen
                                (\externs ->
                                    compileBoehm config thePlan [ "-DGC_THREADS" ]
                                        |> Task.andThen (\_ -> compileLinked config thePlan (executableFlags config thePlan) externs)
                                        |> Task.andThen (\linked -> compile config thePlan linked)
                                )
                            |> Task.andThen (\_ -> finish config thePlan)
                            |> Task.map (\_ -> 0)
            )


{-| What the backend's part of a build answered (D645): the backend's refusal,
written as it is; a file it could not read or write; a library, with its header
if `--output` names one; a program with no `main`; or an executable. Each but
the first two has written `program.c`. -}
type Printed
    = Refused String
    | Trouble { what : String, why : String }
    | Library (Maybe String)
    | NoEntry String
    | Executable


printedDecoder : Decode.Decoder Printed
printedDecoder =
    Decode.oneOf
        [ Decode.field "refused" Decode.string |> Decode.map Refused
        , Decode.map2 (\what why -> Trouble { what = what, why = why })
            (Decode.field "cannot" Decode.string)
            (Decode.field "because" Decode.string)
        , Decode.field "library" (Decode.nullable Decode.string) |> Decode.map Library
        , Decode.field "noEntry" Decode.string |> Decode.map NoEntry
        , Decode.field "executable" Decode.bool |> Decode.map (\_ -> Executable)
        ]


{-| The backend's part, on the worker's thread: a request `buildStage` wrote,
answered as `printedDecoder` reads it. -}
serve : FileSystem.Permission -> (String -> Path) -> Decode.Value -> Task Never String
serve fs fromString request =
    when Decode.decodeValue (Decode.field "exe" Decode.string) request is
        Err e ->
            Task.succeed (answer "refused" (Encode.string ("The backend's request was not one it reads: " ++ Decode.errorToString e)))

        Ok exe ->
            let
                thePlan =
                    paths (fromString exe)
            in
            readStage fs thePlan.stage
                |> Task.andThen
                    (\files ->
                        when Build.link files |> Result.andThen (Build.generate { primPrototypes = False }) is
                            Err why ->
                                Task.succeed (answer "refused" (Encode.string why))

                            Ok out ->
                                FileSystem.writeFile fs (Bytes.fromString out.text) (Path.append (Path.fromPosixString "program.c") thePlan.work)
                                    |> Task.andThen (\_ -> FileSystem.writeFile fs (Bytes.fromString out.rows) (Path.append (Path.fromPosixString "geng_rows.h") thePlan.work))
                                    |> Task.mapError (\e -> { what = "I cannot write the C", why = FileSystem.errorToString e })
                                    |> Task.map
                                        (\_ ->
                                            when out.header is
                                                Just header ->
                                                    when libraryName thePlan.exe is
                                                        Ok name ->
                                                            answer "library" (Encode.string (header name))

                                                        Err _ ->
                                                            answer "library" Encode.null

                                                Nothing ->
                                                    when out.noEntry is
                                                        Just why ->
                                                            answer "noEntry" (Encode.string why)

                                                        Nothing ->
                                                            answer "executable" (Encode.bool True)
                                        )
                    )
                |> Task.onError
                    (\trouble ->
                        Task.succeed <|
                            Encode.encode 0 <|
                                Encode.object
                                    [ { key = "cannot", value = Encode.string trouble.what }
                                    , { key = "because", value = Encode.string trouble.why }
                                    ]
                    )


answer : String -> Encode.Value -> String
answer key value =
    Encode.encode 0 (Encode.object [ { key = key, value = value } ])


{-| A library (geng-lang `m3-embed.md` §EM17): the runtime with the boundary,
Boehm's source and the header written beside the C, then Boehm compiled and the
library linked against it. The header is the backend's for the name `--output`
gives, which the worker found as `libraryName` does here, so it is there
whenever the name is. -}
buildLibrary : Config -> Plan -> Maybe String -> Task Report Int
buildLibrary config thePlan header =
    when libraryName thePlan.exe is
        Err report ->
            abandon config.fs thePlan
                |> Task.andThen (\_ -> Task.fail report)

        Ok name ->
            boehmSources {}
                |> Task.andThen
                    (\boehm ->
                        write config.fs thePlan.work (Runtime.sources ++ Runtime.library)
                            |> Task.andThen (\_ -> write config.fs (boehmDirectory thePlan) boehm)
                            |> Task.andThen (\_ -> write config.fs (Path.parentPath thePlan.exe |> Maybe.withDefault Path.empty) [ { name = name ++ ".h", text = Maybe.withDefault "" header } ])
                    )
                |> Task.andThen (\_ -> externSources config)
                |> Task.andThen
                    (\externs ->
                        compileBoehm config thePlan []
                            |> Task.andThen (\_ -> compileLinked config thePlan (Array.keepIf (\flag -> not (linkOnly flag)) (libraryFlags config thePlan name)) externs)
                            |> Task.andThen (\linked -> compileLibrary config thePlan name linked)
                    )
                |> Task.andThen (\_ -> finish config thePlan)
                |> Task.map (\_ -> 0)


{-| The output's file name less a leading `lib` and everything from its first
dot, which must be a C identifier, since every name the library has starts with
it. -}
libraryName : Path -> Result Report String
libraryName exe =
    let
        file =
            Path.filenameWithExtension exe

        unprefixed =
            if String.startsWith "lib" file && file /= "lib" then
                String.dropFirst 3 file

            else
                file

        name =
            String.split "." unprefixed
                |> Array.first
                |> Maybe.withDefault ""

        identifier c =
            (Char.toCode c < 128 && Char.isAlphaNum c) || c == '_'
    in
    if name /= "" && String.all identifier name && not (String.any Char.isDigit (String.takeFirst 1 name)) then
        Ok name

    else
        Err <|
            Report.create
                "THAT IS NOT A LIBRARY'S NAME"
                Nothing
                (PP.verticalBlock
                    [ PP.words ("This application's runtime is host, so it is a library, and its name comes from --output: " ++ file ++ " less a leading lib and everything from its first dot, which is \"" ++ name ++ "\". Every function the library has starts with that name, so it has to be a C identifier: letters, digits and underscores, not starting with a digit.")
                    , PP.empty
                    , PP.words "Give me an output like libmylib.so, which builds the library mylib."
                    ]
                )


{-| Boehm's source, out of this compiler (D627): a function, so that it is
decoded only by a native build, and not each time the compiler starts. -}
boehmSources : {} -> Task Report (Array { name : String, text : String })
boehmSources {} =
    Stream.fromArray [ Build.base64 Runtime.boehm ]
        |> Task.andThen (Stream.awaitAndPipeThrough Stream.gzipDecompression)
        |> Task.andThen (Stream.readUntilClosed (\chunk chunks -> Ok (Array.pushLast chunk chunks)) [])
        |> Task.mapError (\_ -> "it would not decompress")
        |> Task.andThen
            (\chunks ->
                when Bytes.toString (Bytes.flatten chunks) |> Result.fromMaybe "it is not UTF-8" |> Result.andThen Build.boehm is
                    Ok files ->
                        Task.succeed files

                    Err why ->
                        Task.fail why
            )
        |> Task.mapError
            (\why ->
                Report.create
                    "THIS COMPILER'S BOEHM IS BROKEN"
                    Nothing
                    (PP.words ("A native build carries its own Boehm, whose source this compiler carries, and " ++ why ++ ". That is a defect in the compiler."))
            )


boehmDirectory : Plan -> Path
boehmDirectory thePlan =
    Path.append (Path.fromPosixString "boehm") thePlan.work


{-| A built program's scratch directory: gone, or with debug information kept
for the debugger, all but the stage (D512). The next build's `prepare` removes
it either way. -}
finish : Config -> Plan -> Task Report {}
finish config thePlan =
    if config.debugInfo then
        FileSystem.remove config.fs { recursive = True } thePlan.stage
            |> Task.map (\_ -> {})
            |> Task.onError (\_ -> Task.succeed {})

    else
        abandon config.fs thePlan


write : FileSystem.Permission -> Path -> Array { name : String, text : String } -> Task Report {}
write fs directory files =
    files
        |> Array.map
            (\file ->
                let
                    path =
                        Path.append (Path.fromPosixString file.name) directory
                in
                FileSystem.makeDirectory fs { recursive = True } (Path.parentPath path |> Maybe.withDefault directory)
                    |> Task.andThen (\_ -> FileSystem.writeFile fs (Bytes.fromString file.text) path)
                    |> Task.mapError (failure "I cannot write the C")
            )
        |> Task.sequence
        |> Task.map (\_ -> {})


{-| Every `src/Ext/*.c` a package of this build has (`ffi.md` F1), each once. -}
externSources : Config -> Task Report (Array Path)
externSources config =
    config.packages
        |> Array.map (extFiles config)
        |> Task.sequence
        |> Task.map
            (Array.flatten
                >> Array.foldl
                    (\path acc ->
                        if Array.member path acc then
                            acc

                        else
                            Array.pushLast path acc
                    )
                    []
            )


{-| A package's `src/Ext/*.c`, sorted, or none when it has no `src/Ext`. -}
extFiles : Config -> Path -> Task Report (Array Path)
extFiles config root =
    let
        directory =
            Path.append (Path.fromPosixString "Ext") (Path.append (Path.fromPosixString "src") root)
    in
    FileSystem.listDirectory config.fs directory
        |> Task.map
            (\entries ->
                entries
                    |> Array.map (\entry -> Path.filenameWithExtension entry.path)
                    |> Array.keepIf (String.endsWith ".c")
                    |> Array.sort
                    |> Array.map (\name -> Path.append (Path.fromPosixString name) directory)
            )
        |> Task.onError (\_ -> Task.succeed [])


{-| What a build's C is, once D890's packages are compiled apart: the C still
compiled with the program, the objects those packages made, and their modules'
`--libs`, in the order the packages came. -}
type alias Compiled =
    { sources : Array Path
    , objects : Array String
    , libraries : Array String
    }


{-| Each package that names `pkg-config` modules (D890): its modules' `--cflags`
and `--libs`, and each of its `src/Ext/*.c` compiled to an object with `flags`,
which are every flag the program's own C has, and then the `--cflags`. The rest
of `externs` is compiled with the program, as it was before D890. -}
compileLinked : Config -> Plan -> Array String -> Array Path -> Task Report Compiled
compileLinked config thePlan flags externs =
    checkRows config thePlan externs
        |> Task.andThen (compileApart config thePlan flags externs)


{-| Each `src/Ext/*.c` to be compiled through a file of the build's own that
includes it and then `geng_rows.h`, the backend's prototype of every `c` row
the program calls, as the program calls it (`ffi.md` F1, D893). A row defined
at another type, or as a pure function where the program calls a `Task` row,
is then a declaration that conflicts with its definition, which the C
compiler refuses. The header comes after the row's C, so whatever the file
defines before its own includes, `_GNU_SOURCE` among them, still comes first;
and the runtime's C and the program's are compiled without it. A file's own
`#include "…"` still looks in its own directory first, since that is where the
included file is. -}
checkRows : Config -> Plan -> Array Path -> Task Report (Dict String Path)
checkRows config thePlan externs =
    let
        quoted path =
            "\""
                ++ (config.toString path
                        |> String.replace "\\" "\\\\"
                        |> String.replace "\"" "\\\""
                   )
                ++ "\""
    in
    externs
        |> Array.indexedMap
            (\index file ->
                let
                    name =
                        "geng_row_check_" ++ String.fromInt index ++ ".c"

                    wrapper =
                        Path.append (Path.fromPosixString name) thePlan.work
                in
                write config.fs
                    thePlan.work
                    [ { name = name
                      , text =
                            "/* The c rows of "
                                ++ Path.filenameWithExtension file
                                ++ ", then how the program calls them (D893). */\n#include "
                                ++ quoted file
                                ++ "\n#include \"geng_rows.h\"\n"
                      }
                    ]
                    |> Task.map (\_ -> { key = config.toString file, value = wrapper })
            )
        |> Task.sequence
        |> Task.map (Array.foldl (\entry acc -> Dict.set entry.key entry.value acc) Dict.empty)


compileApart : Config -> Plan -> Array String -> Array Path -> Dict String Path -> Task Report Compiled
compileApart config thePlan flags externs checked =
    let
        through file =
            Dict.get (config.toString file) checked
                |> Maybe.withDefault file
    in
    config.linked
        |> Array.keepIf (\linked -> not (Array.isEmpty linked.modules))
        |> Array.indexedMap
            (\index linked ->
                pkgConfig config linked "--cflags"
                    |> Task.andThen
                        (\cflags ->
                            pkgConfig config linked "--libs"
                                |> Task.andThen
                                    (\libs ->
                                        extFiles config linked.root
                                            |> Task.andThen
                                                (\files ->
                                                    files
                                                        |> Array.map
                                                            (\file ->
                                                                let
                                                                    object =
                                                                        config.toString
                                                                            (Path.append
                                                                                (Path.fromPosixString ("linked-" ++ String.fromInt index ++ "-" ++ String.dropLast 2 (Path.filenameWithExtension file) ++ ".o"))
                                                                                thePlan.work
                                                                            )
                                                                in
                                                                cc config ([ "-c" ] ++ flags ++ cflags ++ [ "-o", object, config.toString (through file) ])
                                                                    |> Task.map (\_ -> object)
                                                            )
                                                        |> Task.sequence
                                                        |> Task.map (\objects -> { files = files, objects = objects, libs = libs })
                                                )
                                    )
                        )
            )
        |> Task.sequence
        |> Task.map
            (\done ->
                let
                    apart =
                        Array.mapAndFlatten .files done
                in
                { sources = Array.keepIf (\file -> not (Array.member file apart)) externs |> Array.map through
                , objects = Array.mapAndFlatten .objects done
                , libraries = Array.mapAndFlatten .libs done
                }
            )


{-| `pkg-config` asked for one kind of flag for a package's modules, split on
white space. A module it does not know is a report naming the package and the
module, found by asking it of each module once the whole list failed. A flag
holding a backslash, which is how `pkg-config` writes a space in a path, is
refused rather than split wrong. -}
pkgConfig : Config -> Linked -> String -> Task Report (Array String)
pkgConfig config linked kind =
    let
        options =
            { shell = ChildProcess.NoShell
            , workingDirectory = ChildProcess.InheritWorkingDirectory
            , environmentVariables = ChildProcess.InheritEnvironmentVariables
            , maximumBytesWrittenToStreams = 1024 * 1024
            , runDuration = ChildProcess.NoLimit
            }

        text bytes =
            Bytes.toString bytes |> Maybe.withDefault ""

        unknown module_ =
            ChildProcess.run config.cp config.tools.pkgConfig [ "--exists", module_ ] options
                |> Task.map (\_ -> Nothing)
                |> Task.onError (\_ -> Task.succeed (Just module_))

        refuse message =
            Report.create "A PACKAGE'S C LIBRARY IS NOT FOUND" Nothing (PP.verticalBlock message)
    in
    ChildProcess.run config.cp config.tools.pkgConfig (Array.pushFirst kind linked.modules) options
        |> Task.onError
            (\failed ->
                when failed is
                    ChildProcess.InitError err ->
                        Task.fail <|
                            Report.create
                                "I CANNOT RUN PKG-CONFIG"
                                Nothing
                                (PP.verticalBlock
                                    [ PP.words (linked.name ++ " names the C libraries it links in its [native] table, which a native build asks pkg-config about, and I could not start " ++ config.tools.pkgConfig ++ ": " ++ err.errorCode ++ ".")
                                    , PP.empty
                                    , PP.words "Put pkg-config on your PATH, or tell me which one to run with the GENG_PKG_CONFIG environment variable."
                                    ]
                                )

                    ChildProcess.ProgramError err ->
                        linked.modules
                            |> Array.map unknown
                            |> Task.sequence
                            |> Task.andThen
                                (\answers ->
                                    when Array.mapAndKeepJust identity answers |> Array.first is
                                        Just module_ ->
                                            Task.fail <|
                                                refuse
                                                    [ PP.words (linked.name ++ " links the C library pkg-config calls " ++ module_ ++ ", in its [native] table, and pkg-config does not know it.")
                                                    , PP.empty
                                                    , PP.words "Install its development files, or add the directory holding its .pc file to PKG_CONFIG_PATH."
                                                    ]

                                        Nothing ->
                                            Task.fail <|
                                                refuse
                                                    [ PP.words (linked.name ++ " links " ++ String.join ", " linked.modules ++ ", in its [native] table, and pkg-config " ++ kind ++ " failed with status " ++ String.fromInt err.exitCode ++ ":")
                                                    , PP.empty
                                                    , PP.words (String.trim (text err.stderr))
                                                    ]
                                )
            )
        |> Task.andThen
            (\ran ->
                let
                    output =
                        text ran.stdout
                in
                if String.contains "\\" output then
                    Task.fail <|
                        refuse
                            [ PP.words (linked.name ++ "'s pkg-config modules answer " ++ kind ++ " with a backslash, which is how pkg-config writes a space in a path, and a path with a space is not something I can pass on yet:")
                            , PP.empty
                            , PP.words (String.trim output)
                            ]

                else
                    Task.succeed
                        (output
                            |> String.replace "\n" " "
                            |> String.replace "\t" " "
                            |> String.split " "
                            |> Array.keepIf (\flag -> flag /= "")
                        )
            )


{-| Every flag the executable's C is compiled with but its sources and output,
which a package's C compiled apart is given too (D890). -}
executableFlags : Config -> Plan -> Array String
executableFlags config thePlan =
    let
        boehm file =
            config.toString (Path.append (Path.fromPosixString file) (boehmDirectory thePlan))
    in
    programFlags config thePlan
        ++ [ "-I", boehm "include/gc", "-I", boehm "include" ]
        ++ config.tools.flags
        ++ [ "-I", config.toString thePlan.work ]


{-| The executable: the program and the runtime, and Boehm's object, its
headers ahead of any `GENG_CFLAGS` names, as a library's are; then the objects
of the packages compiled apart, their libraries, and the runtime's (D890). -}
compile : Config -> Plan -> Compiled -> Task Report {}
compile config thePlan compiled =
    let
        in_ name =
            config.toString (Path.append (Path.fromPosixString name) thePlan.work)

        boehm file =
            config.toString (Path.append (Path.fromPosixString file) (boehmDirectory thePlan))

        args =
            executableFlags config thePlan
                ++ [ "-o", config.toString thePlan.exe ]
                ++ [ in_ "program.c", in_ "geng.c", in_ "geng_rt.c", boehm "gc.o" ]
                ++ Array.map config.toString compiled.sources
                ++ compiled.objects
                ++ compiled.libraries
                ++ [ "-lpthread", "-lm" ]
    in
    keepCommand config thePlan args
        |> Task.andThen (\_ -> cc config args)


{-| With `--debug-info`, the C compiler's command kept beside the C it
compiles, as `compile.sh` (geng-lang `m4-profile.md` D1002): `sh compile.sh
[OUTPUT [FLAG...]]` compiles the directory's C again, into OUTPUT or where the
build put it, with any FLAGs after the build's own, from wherever the
directory is, so that a copy of it edited by hand or by a script is compiled
as the build compiled it. A path in the build directory is written as one in
the directory the script is in. -}
keepCommand : Config -> Plan -> Array String -> Task Report {}
keepCommand config thePlan args =
    if config.debugInfo then
        let
            work =
                config.toString thePlan.work

            quote s =
                "'" ++ String.replace "'" "'\\''" s ++ "'"

            inWork s =
                String.split work s
                    |> Array.map quote
                    |> String.join "\"$D\""

            step arg acc =
                if acc.output then
                    { output = False, words = Array.pushLast "\"$OUT\"" acc.words }

                else
                    { output = arg == "-o", words = Array.pushLast (inWork arg) acc.words }

            words =
                (Array.foldl step { output = False, words = [] } args).words

            script =
                String.join "\n"
                    [ "#!/bin/sh"
                    , "# The C compiler's command for this build, as geng make ran it: `sh compile.sh"
                    , "# [OUTPUT [FLAG...]]` compiles this directory's C again, into OUTPUT or where"
                    , "# the build put it, with any FLAGs after the build's own (geng-lang"
                    , "# m4-profile.md D1002)."
                    , "D=$(cd \"$(dirname \"$0\")\" && pwd)"
                    , "OUT=${1:-" ++ quote (config.toString thePlan.exe) ++ "}"
                    , "[ $# -gt 0 ] && shift"
                    , "NIX_HARDENING_ENABLE= exec " ++ quote config.tools.cc ++ " " ++ String.join " " words ++ " \"$@\""
                    , ""
                    ]
        in
        write config.fs thePlan.work [ { name = "compile.sh", text = script } ]

    else
        Task.succeed {}


{-| D490's flags, the optimization, `-g` when asked for, and the `#line` names
mapped to the files (D513), which a program and a library are compiled with. -}
programFlags : Config -> Plan -> Array String
programFlags config thePlan =
    let
        in_ name =
            config.toString (Path.append (Path.fromPosixString name) thePlan.work)

        -- The names `#line` gives, mapped to the files (D513); `program.c` is
        -- what the C calls itself where the Geng code ends.
        maps =
            Array.pushFirst { name = "program.c", path = in_ "program.c" } config.sources
                |> Array.map (\m -> "-ffile-prefix-map=" ++ m.name ++ "=" ++ m.path)
    in
    [ "-std=c11", config.optimization, "-ffp-contract=off", "-fno-fast-math", "-fstack-clash-protection" ]
        ++ debugFlags config
        ++ maps


debugFlags : Config -> Array String
debugFlags config =
    if config.debugInfo then
        [ "-g" ]

    else
        []


{-| Boehm, on its own: the release's flags, with nothing of the program's,
since it is the release's C and not the backend's (D626), and `GC_THREADS` for
an executable, which `geng_gc.c` builds as the release's configure does (D644).
Its headers come first, ahead of any `GENG_CFLAGS` names, so that a machine's
own Boehm is not the one compiled against. -}
compileBoehm : Config -> Plan -> Array String -> Task Report {}
compileBoehm config thePlan defines =
    let
        boehm name =
            config.toString (Path.append (Path.fromPosixString name) (boehmDirectory thePlan))
    in
    cc config
        ([ "-c", config.optimization, "-fPIC", "-fvisibility=hidden" ]
            ++ defines
            ++ debugFlags config
            ++ [ "-I", boehm "include/gc" ]
            ++ config.tools.flags
            ++ [ "-o", boehm "gc.o", boehm "geng_gc.c" ]
        )


{-| Every flag the library is built with but its sources and output. A package's
C compiled apart is given them less the two that are the link's, `-shared`
and `-z nodelete` (D890). -}
libraryFlags : Config -> Plan -> String -> Array String
libraryFlags config thePlan name =
    let
        boehm file =
            config.toString (Path.append (Path.fromPosixString file) (boehmDirectory thePlan))
    in
    programFlags config thePlan
        ++ [ "-fPIC", "-shared", "-fvisibility=hidden", "-Wl,-z,nodelete", "-DGENG_LIBRARY=" ++ name ]
        ++ [ "-I", config.toString thePlan.work, "-I", boehm "include/gc", "-I", boehm "include" ]
        ++ config.tools.flags


linkOnly : String -> Bool
linkOnly flag =
    flag == "-shared" || flag == "-Wl,-z,nodelete"


{-| The library: the program and the runtime with the boundary, under its name,
every symbol hidden but the ones the header names, and Boehm's object; then the
objects of the packages compiled apart, and their libraries (D890). -}
compileLibrary : Config -> Plan -> String -> Compiled -> Task Report {}
compileLibrary config thePlan name compiled =
    let
        in_ file =
            config.toString (Path.append (Path.fromPosixString file) thePlan.work)

        boehm file =
            config.toString (Path.append (Path.fromPosixString file) (boehmDirectory thePlan))
    in
    cc config
        (libraryFlags config thePlan name
            ++ [ "-o", config.toString thePlan.exe ]
            ++ [ in_ "program.c", in_ "geng.c", in_ "geng_rt.c", in_ "geng_embed.c", boehm "gc.o" ]
            ++ Array.map config.toString compiled.sources
            ++ compiled.objects
            ++ compiled.libraries
            ++ [ "-lm" ]
        )


cc : Config -> Array String -> Task Report {}
cc config args =
    { (ChildProcess.defaultSpawnOptions ChildProcess.Integrated)
        | shell = ChildProcess.NoShell
        , environmentVariables = ChildProcess.MergeWithEnvironmentVariables (Dict.singleton "NIX_HARDENING_ENABLE" "")
    }
        |> ChildProcess.spawn config.cp config.tools.cc args
        |> Task.mapError
            (\err ->
                Report.create
                    "I CANNOT RUN THE C COMPILER"
                    Nothing
                    (PP.verticalBlock
                        [ PP.words ("A build for the native target runs " ++ config.tools.cc ++ ", and I could not start it: " ++ err.errorCode ++ ".")
                        , PP.empty
                        , PP.words "The C compiler is not part of this compiler. Put clang on your PATH, or tell me which compiler to run with the GENG_CC environment variable."
                        ]
                    )
            )
        |> Task.andThen ChildProcess.waitForExit
        |> Task.andThen
            (\exitCode ->
                if exitCode == 0 then
                    Task.succeed {}

                else
                    Task.fail <|
                        Report.create
                            "THE C COMPILER REFUSED THIS PROGRAM"
                            Nothing
                            (PP.verticalBlock
                                [ PP.words (config.tools.cc ++ " exited with status " ++ String.fromInt exitCode ++ ", and what it printed is above.")
                                , PP.empty
                                , PP.words "What is left for it to refuse once the backend has printed every binding is a src/Ext/*.c file of one of your packages, or a defect in the backend."
                                ]
                            )
            )


{-| The stage's Core files, in order of name, or the trouble reading them. -}
readStage : FileSystem.Permission -> Path -> Task { what : String, why : String } (Array Build.File)
readStage fs directory =
    let
        cannot e =
            { what = "I cannot read the stage directory", why = FileSystem.errorToString e }
    in
    FileSystem.listDirectory fs directory
        |> Task.mapError cannot
        |> Task.andThen
            (\entries ->
                entries
                    |> Array.map (\entry -> Path.filenameWithExtension entry.path)
                    |> Array.keepIf Build.isCore
                    |> Array.sort
                    |> Array.map
                        (\name ->
                            FileSystem.readFile fs (Path.append (Path.fromPosixString name) directory)
                                |> Task.mapError cannot
                                |> Task.map (\data -> { name = name, data = data })
                        )
                    |> Task.sequence
            )


failure : String -> FileSystem.Error -> Report
failure what error =
    failureText what (FileSystem.errorToString error)


failureText : String -> String -> Report
failureText what why =
    Report.create
        "CANNOT BUILD FOR NATIVE"
        Nothing
        (PP.verticalBlock
            [ PP.words (what ++ ":")
            , PP.empty
            , PP.words why
            ]
        )
