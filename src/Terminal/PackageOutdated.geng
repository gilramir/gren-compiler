module Terminal.PackageOutdated exposing
    ( Error (..)
    , run
    , prettifyError
    )


import ChildProcess
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.Paths
import Compiler.Outline as Outline exposing (Outline)
import Stream
import Stream.Log
import Task exposing (Task)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Bytes exposing (Bytes)
import SemanticVersion exposing (SemanticVersion)
import Terminal.PackageInstall as PackageInstall
import Cli.Report as Report exposing (Report)


type alias Config =
    { fsPermission : FileSystem.Permission
    , cpPermission : ChildProcess.Permission
    , cacheRoot : Compiler.Paths.CacheRoot
    , corePath : Path
    , interactive : Bool
    , useColor : Bool
    , stdout : Stream.Writable Bytes
    , stdin : Stream.Readable Bytes
    }


type alias Options =
    { projectPath : Path
    , outline : Outline
    }


type Error
    = FailedToResolve PackageInstall.PackageInstallError


{-| Say which of the dependencies `geng.toml` lists have a newer release than the
version the project is built with.
-}
run : Config -> Options -> Task Error {}
run config options =
    PackageInstall.newerVersions
        { fsPermission = config.fsPermission
        , cpPermission = config.cpPermission
        , cacheRoot = config.cacheRoot
        , corePath = config.corePath
        , interactive = config.interactive
        , useColor = config.useColor
        , stdout = config.stdout
        , stdin = config.stdin
        }
        options
        |> Task.mapError FailedToResolve
        |> Task.andThen
            (\newer ->
                if newer == [] then
                    Stream.Log.line config.stdout "All dependencies are up to date."

                else
                    let
                        plan =
                            "There are new versions of the following dependencies:\n\n"
                                ++ (Array.foldl
                                        (\package acc ->
                                            acc
                                                ++ "  "
                                                ++ PackageName.toString package.name
                                                ++ " "
                                                ++ SemanticVersion.toString package.current
                                                ++ " -> "
                                                ++ SemanticVersion.toString package.latest
                                                ++ "\n"
                                        )
                                        ""
                                        newer
                                   )
                    in
                    Stream.Log.line config.stdout plan
            )


prettifyError : Error -> Report
prettifyError error =
    when error is
        FailedToResolve installError ->
            PackageInstall.prettifyError installError
