module Terminal.Run exposing
    ( Error
    , Compiling
    , ProjectOutline
    , Build
    , make
    , makeProjectWith
    , run
    , prettifyError
    )

{-| Support the `geng run ModuleName` command.
-}

import Cli.PrettyPrinter as PP
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.Backend as Backend
import Compiler.Paths
import Bytes exposing (Bytes)
import ChildProcess
import Compiler.Backend
import Compiler.Outline as Outline exposing (Outline)
import Compiler.Runtime as Runtime
import Compiler.Platform as Platform
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Git
import Json.Decode as Decode
import Node
import Stream
import Task exposing (Task)
import Terminal.PackageInstall as PackageInstall exposing (PackageResolution)
import Terminal.Beam
import Terminal.Help as Help
import Cli.Report as Report exposing (Report)


type Error
    = ReadProjectOutlineError PackageInstall.ReadProjectOutlineError
    | PackageInstallError PackageInstall.PackageInstallError
    | NotAnApplication
    | SpawnError ChildProcess.SpawnError


type alias MakeConfig =
    { fsPermission : FileSystem.Permission
    , cacheRoot : Compiler.Paths.CacheRoot
    , corePath : Path
    , cpPermission : ChildProcess.Permission
    , useColor : Bool
    , pathToString : Path -> String
    , moduleName : ModuleName
    , package : Maybe PackageName
    }


{-| The command to hand the backend, where the build will write the program,
and what `Main` needs to finish a build this process cannot.

**A `beam` build is not over when the backend exits**: the backend for that
target is not in the compiler binary, so that process stops at the passed Core
and `Terminal.Beam` makes the program out of it (D382, `m2-beam.md` §BM23).
That is why this answers the resolution rather than swallowing it — the
`src/Ext/*.erl` `erlc` compiles belong to the packages in it — and why the
backend is started by the caller, which is the one place that knows to set
`GENG_STAGE_WRITE` in its environment.
-}
type alias Compiling =
    { encodedCommand : Bytes
    , output : Compiler.Backend.MakeOutput
    , outputPath : Path
    , resolution : PackageResolution
    , beam : Bool
    }


type alias RunConfig =
    { cpPermission : ChildProcess.Permission
    , fsPermission : FileSystem.Permission
    , pathToString : Path -> String
    , path : Path
    , escript : Maybe String
    , environment : Dict String String
    }


type alias ProjectOutline =
    { projectPath : Path
    , outline : Outline
    }


make : MakeConfig -> Task Error Compiling
make config =
    when config.package is
        Just packageName ->
            clonePackage config packageName
                |> Task.andThen (makeProject config)
        Nothing ->
            PackageInstall.readProjectOutline config.fsPermission
                |> Task.mapError ReadProjectOutlineError
                |> Task.andThen (makeProject config)


makeProject : MakeConfig -> ProjectOutline -> Task Error Compiling
makeProject config =
    makeProjectWith config
        { entryPoints = [ config.moduleName ]
        , outputName = "app"
        , prepare = Task.succeed
        }


{-| What a build is of, besides the project: the modules it starts from, the
name of the program under the project's `.gren/`, and a step between
resolving the packages and encoding the command, which `geng test` uses to
add the module it writes to the sources (geng-lang `m2-beam-toptier.md`
§TT33).
-}
type alias Build =
    { entryPoints : Array ModuleName
    , outputName : String
    , prepare : PackageResolution -> Task Error PackageResolution
    }


makeProjectWith : { a | fsPermission : FileSystem.Permission, cacheRoot : Compiler.Paths.CacheRoot, corePath : Path, cpPermission : ChildProcess.Permission, useColor : Bool, pathToString : Path -> String } -> Build -> ProjectOutline -> Task Error Compiling
makeProjectWith config build projectOutline =
    when getOutputPath build.outputName projectOutline is
        Nothing ->
            Task.fail NotAnApplication

        Just { outputType, outputPath } ->
            let
                output : Compiler.Backend.MakeOutput
                output =
                    outputPath
                        |> config.pathToString
                        |> outputType

                installPackages : Stream.Transformation Bytes Bytes -> Task Error PackageResolution
                installPackages nullStream =
                    PackageInstall.run
                        { fsPermission = config.fsPermission
                        , cpPermission = config.cpPermission
                        , cacheRoot = config.cacheRoot
                        , corePath = config.corePath
                        , useColor = config.useColor
                        , interactive = False
                        , stdout = nullStream |> Stream.writable
                        , stdin = nullStream |> Stream.readable
                        }
                        projectOutline
                            |> Task.mapError PackageInstallError

                backendCommand : PackageResolution -> Bytes
                backendCommand packageResolution =
                    Compiler.Backend.encodeCommand
                        { interactiveSession = False
                        , pathToString = config.pathToString
                        }
                        ( Compiler.Backend.Make
                            { optimize = False
                            , sourcemaps = False
                            , output = Just output
                            , report = Nothing
                            , projectPath = packageResolution.projectPath
                            , entryPoints = build.entryPoints
                            , outline = packageResolution.outline
                            , rootSources = packageResolution.rootSources
                            , dependencies = packageResolution.dependencies
                            }
                        )

                compiling : PackageResolution -> Compiling
                compiling packageResolution =
                    { encodedCommand = backendCommand packageResolution
                    , output = output
                    , outputPath = outputPath
                    , resolution = packageResolution
                    , beam = Terminal.Beam.isTarget projectOutline.outline
                    }
            in
            Help.getNullStream
                |> Task.andThen installPackages
                |> Task.andThen build.prepare
                |> Task.map compiling


clonePackage : MakeConfig -> PackageName -> Task Error ProjectOutline
clonePackage config packageName =
    let
        clone =
            Git.fetchLatestVersion config.cpPermission packageName
                |> Task.andThen 
                    (\version ->
                        Git.clonePackageCached
                            { childProcessPermission = config.cpPermission
                            , fileSystemPermission = config.fsPermission
                            , cacheRoot = config.cacheRoot
                            , packageName = packageName
                            , version = version
                            }
                    )
                |> Task.mapError 
                    (\e ->
                        PackageInstallError <|
                            PackageInstall.PackageInstallGitError <|
                                { package = packageName
                                , error = e
                                }
                    )
    in
    Task.await clone <| \repoDir ->
    Task.await (getProjectOutline config.fsPermission repoDir) <| \outline ->
        Task.succeed
            { projectPath = repoDir
            , outline = outline
            }


{-| Run the program `make` built, and answer its exit status.

A `beam` build names the program that runs its escript, because its toolchain
is resolved where it was built. Everything else is read back off disk: a
JavaScript program is run by its project's platform, and the outline that says
which is found from the path.
-}
run : RunConfig -> Task Error Int
run config =
    when config.escript is
        Just escriptProgram ->
            runEscript config escriptProgram

        Nothing ->
            runForPlatform config


{-| D384's escript, run by the `escript` this build resolved (D390).

**Not `./app` by its shebang**, which is how a person runs it and how
`harness/run.py` does. The shebang is `/usr/bin/env escript`, so it finds
whatever is on `PATH` and ignores the `--escript=` and `GENG_ESCRIPT` that
built the program moments ago — on a machine where Erlang is not on `PATH`
that is a build that succeeds and a run that cannot start. `escript FILE`
reads the same header, `-escript main geng_main` and all, so the program that
runs is the same one.

**No shell**, for §BM24's reason: under one a missing `escript` arrives as the
shell's 127 rather than as a spawn that failed to start, and the message that
names the program is the useful one.
-}
runEscript : RunConfig -> String -> Task Error Int
runEscript config escriptProgram =
    { (ChildProcess.defaultSpawnOptions ChildProcess.Integrated)
        | shell = ChildProcess.NoShell
        , environmentVariables =
            if Dict.isEmpty config.environment then
                ChildProcess.InheritEnvironmentVariables

            else
                -- D418: the application's `erlang-libraries`, as `ERL_LIBS`.
                ChildProcess.MergeWithEnvironmentVariables config.environment
    }
        |> ChildProcess.spawn config.cpPermission escriptProgram [ config.pathToString config.path ]
        |> Task.mapError SpawnError
        |> Task.andThen ChildProcess.waitForExit


runForPlatform : RunConfig -> Task Error Int
runForPlatform config =
    let
        getOutline =
            config.path
                -- compiled to [project path]/.gren/filename
                |> Path.parentPath
                |> Maybe.andThen Path.parentPath
                |> Maybe.withDefault (Path.fromPosixString ".")
                |> getProjectOutline config.fsPermission
    in
    Task.await getOutline <| \outline ->
    Task.await Node.getPlatform <| \systemPlatform ->
        let
            projectPlatform =
                when outline is
                    Outline.Pkg outline_ ->
                        Runtime.toPlatform outline_.runtime
                            |> Maybe.withDefault Platform.Common
                    Outline.App outline_ ->
                        Outline.appPlatform outline_

            path =
                config.pathToString config.path
            
            runWith command =
                ChildProcess.defaultSpawnOptions ChildProcess.Integrated
                    |> ChildProcess.spawn config.cpPermission command [ path ]
                    |> Task.mapError SpawnError
                    |> Task.andThen ChildProcess.waitForExit
        in
        when projectPlatform is
            Platform.Node ->
                runWith "node"

            Platform.Common ->
                Task.fail NotAnApplication

            Platform.Browser ->
                when systemPlatform is
                    Node.Win32 ->
                        runWith "start"

                    _ ->
                        runWith "open"


-- HELPERS


getProjectOutline : FileSystem.Permission -> Path -> Task Error Outline
getProjectOutline fsPermission path =
    path
        |> Path.append (Path.fromPosixString Outline.fileName)
        |> PackageInstall.readOutline fsPermission
        |> Task.mapError (PackageInstall.ReadProjectOutlineNoProject >> ReadProjectOutlineError)
        |> Task.andThen
            (\decodeResult ->
                when decodeResult is
                    Ok outline ->
                        Task.succeed outline
                    Err err ->
                        { path = Path.append (Path.fromPosixString Outline.fileName) path, message = err }
                            |> PackageInstall.ReadProjectOutlineInvalid
                            |> ReadProjectOutlineError
                            |> Task.fail
            )

getOutputPath : String -> ProjectOutline -> Maybe { outputType : (String -> Backend.MakeOutput), outputPath : Path }
getOutputPath exeName projectOutline =
    let
        platform =
            when projectOutline.outline is
                Outline.Pkg outline ->
                    Runtime.toPlatform outline.runtime
                        |> Maybe.withDefault Platform.Common
                Outline.App outline ->
                    Outline.appPlatform outline

        getPath outputType fileName =
            { outputType =
                outputType
            , outputPath =
                ".gren/" ++ fileName
                    |> Path.fromPosixString
                    |> Path.prepend projectOutline.projectPath
            }
    in
    when platform is
        Platform.Node ->
            Just (getPath Backend.Exe exeName)
        Platform.Browser ->
            Just (getPath Backend.Html "app.html")
        Platform.Common ->
            Nothing


prettifyError : Error -> Report
prettifyError error =
    when error is
        NotAnApplication ->
            Report.create
                "NOT AN APPLICATION"
                Nothing
                ( PP.words 
                    "The module you are trying to run is not an application."
                )

        ReadProjectOutlineError err ->
            PackageInstall.prettifyProjectOutlineError err

        PackageInstallError err ->
            PackageInstall.prettifyError err

        SpawnError err ->
            Report.create
                "CANNOT START A PROCESS"
                Nothing
                ( PP.words
                    ("I could not start `" ++ err.program ++ "`: " ++ err.errorCode)
                )

