module Terminal.Parser exposing
    ( Command (..)
    , MakeFlags
    , ReleaseFlags
    , FormatFlags
    , ProtobufFlags
    , DiffArgs (..)
    , parser
    )


import Cli.Parser
import Cli.PrettyPrinter as PP
import Compiler.Backend
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.Platform as Platform exposing (Platform)
import Compiler.ModuleName as ModuleName exposing (ModuleName)
import Terminal.Paths as Paths
import SemanticVersion exposing (SemanticVersion)
import FileSystem.Path as Path exposing (Path)
import Meta


type Command
    = Init InitFlags
    | Make MakeFlags
    | Release ReleaseFlags
    | Docs DocsFlags
    | PackageInstall (Maybe PackageName)
    | PackageUninstall PackageName
    | PackageOutdated
    | PackageValidate
    | PackageBump
    | PackageDiff DiffArgs
    | Paths Paths.Options
    | Run RunOptions
    | Format FormatFlags
    | Protobuf ProtobufFlags


type alias InitFlags =
    { package : Bool
    , platform : Platform
    }


type alias MakeFlags =
    { optimize : Bool
    , sourcemaps : Bool
    , output : Maybe Compiler.Backend.MakeOutput
    , report : Maybe {}
    , erlc : Maybe String
    , escript : Maybe String
    , entryPoints : Array ModuleName
    }


{-| `geng release` (geng-lang `m2-otp-app.md` D437): the modules to build, the
release directory, and the BEAM toolchain as `make` takes it.
-}
type alias ReleaseFlags =
    { output : Maybe String
    , erlc : Maybe String
    , escript : Maybe String
    , entryPoints : Array ModuleName
    }


type alias FormatFlags =
    { paths : Array Path
    , check : Bool
    }


type alias ProtobufFlags =
    { paths : Array Path
    , describe : Bool
    , protoPath : Maybe Path
    , output : Maybe Path
    }


type alias DocsFlags =
    { output : Maybe Compiler.Backend.DocsOutput
    , report : Maybe {}
    }


type alias RunOptions =
    { moduleName : ModuleName
    , package : Maybe PackageName
    , erlc : Maybe String
    , escript : Maybe String
    }


type DiffArgs
    = DiffLatest
    | DiffVersion SemanticVersion
    | DiffRange { lower : SemanticVersion, upper : SemanticVersion }
    | DiffGlobal { package : PackageName, lower : SemanticVersion, upper : SemanticVersion }


parser : Cli.Parser.App Command
parser =
    let
        versionString =
            SemanticVersion.toString Meta.version
    in
    { name = "geng"
    , version = versionString
    , intro = 
        PP.verticalBlock
            [ PP.block
                [ PP.text "Hi, thank you for trying out "
                , PP.intenseColor PP.Green <| PP.text ("Gren " ++ versionString)
                , PP.text ". I hope you like it!"
                ]
            , PP.empty
            , PP.intenseColor PP.Black <|
                PP.text
                    """
                    -------------------------------------------------------------------------------
                    I highly recommend working through <https://gren-lang.org/learn> to get started
                    It teaches the important concepts. Where it says `gren`, this compiler is `geng`
                    -------------------------------------------------------------------------------
                    """
            ]
    , outro = 
        PP.words
            """
            Be sure to ask on the Gren Discord (https://discord.gg/Chb9YB9Vmh) if you run into trouble!
            Folks are friendly and happy to help out. They hang out there because it is fun, so be kind
            to get the best results!
            """
    , commands =
        Cli.Parser.defineGroup
            |> Cli.Parser.withCommand
                { word = "init"
                , arguments =
                    Cli.Parser.noArgs
                , flags =
                    Cli.Parser.initFlags 
                        (\package maybePlatform ->
                            { package = package
                            , platform = 
                                if package then
                                    Maybe.withDefault Platform.Common maybePlatform

                                else
                                    Maybe.withDefault Platform.Browser maybePlatform
                            }
                        )
                        |> Cli.Parser.toggle "package" "Create a package (as opposed to an application)"
                        |> Cli.Parser.flag "platform" initPlatformParser "Which platform to target"
                , commonDescription =
                    Just "Start a Geng project. It creates a starter geng.toml file."
                , summary =
                    "The `init` command helps start Gren project:"
                , example = 
                    PP.words
                        """
                        It will ask permission to create a geng.toml file, the one thing
                        common to all Gren project.
                        """
                , builder =
                    \_args flags -> Init flags
                }
            |> Cli.Parser.withCommand
                { word = "paths"
                , arguments =
                    Cli.Parser.noArgs
                , flags =
                    Cli.Parser.initFlags
                        (\project cache backend json ->
                            { project = project
                            , cache = cache
                            , backend = backend
                            , json = json
                            }
                        )
                        |> Cli.Parser.toggle "project" "Only output the path to the project"
                        |> Cli.Parser.toggle "cache" "Only output the path to the compiler cache"
                        |> Cli.Parser.toggle "backend" "Only output the path to the compiler backend"
                        |> Cli.Parser.toggle "json" "Output in JSON format"
                , commonDescription = Nothing
                , summary =
                    "Return the paths used for compiling a project."
                , example = 
                    PP.verticalBlock
                        [ PP.words "For example:"
                        , PP.empty
                        , PP.words "geng paths --backend"
                            |> PP.indent
                            |> PP.color PP.Green
                        , PP.empty
                        , PP.words
                            """
                            This will write the path to the compiler backend.
                            Executing the command without any flags will print _all_ relevant paths.
                            """
                        ]
                , builder =
                    \_args flags -> Paths flags
                }
            |> Cli.Parser.withCommand
                { word = "fmt"
                , arguments =
                    Cli.Parser.zeroOrMoreArgs Cli.Parser.pathParser
                , flags =
                    Cli.Parser.initFlags
                        (\check ->
                            { check = check
                            }
                        )
                        |> Cli.Parser.toggle "check" "Do not write anything. Exit with an error listing the files that are not formatted, which is what CI wants."
                , commonDescription = Nothing
                , summary =
                    "Format Gren source code."
                , example =
                    PP.verticalBlock
                        [ PP.words
                            """
                            There is one format and there is nothing to configure. With no arguments
                            this formats every source file in the project; give it files or
                            directories to format those instead, and a directory is walked all the
                            way down.
                            """
                        , PP.empty
                        , PP.words "geng fmt --check"
                            |> PP.indent
                            |> PP.color PP.Green
                        , PP.empty
                        , PP.words
                            """
                            This changes nothing and fails if anything would have changed. Compiling
                            does not care whether your code is formatted; this is how you make CI
                            care.
                            """
                        ]
                , builder =
                    \args flags -> Format { paths = args, check = flags.check }
                }
            |> Cli.Parser.withCommand
                { word = "protobuf"
                , arguments =
                    Cli.Parser.zeroOrMoreArgs Cli.Parser.pathParser
                , flags =
                    Cli.Parser.initFlags
                        (\describe protoPath output ->
                            { describe = describe
                            , protoPath = protoPath
                            , output = output
                            }
                        )
                        |> Cli.Parser.toggle "describe" "Print what each file declares, with every type name resolved, one declaration a line, and generate nothing."
                        |> Cli.Parser.flag "proto-path" Cli.Parser.pathParser "The directory each file's module name is taken from, as protoc's --proto_path is: schema/geng/core/v7.proto below schema is the module Geng.Core.V7. The current directory when it is not given."
                        |> Cli.Parser.flag "output" Cli.Parser.pathParser "The directory to write the modules into, each at the path its module name gives it."
                , commonDescription = Nothing
                , summary =
                    "Generate Geng modules from proto3 files."
                , example =
                    PP.verticalBlock
                        [ PP.words
                            """
                            Reads each .proto file and refuses what proto3 refuses, and what this
                            compiler does not read yet (proto2, editions, imports, services), with the
                            line and column of each. Then it writes one Geng module per file, with a
                            type, a decoder and an encoder for every message and enum.
                            """
                        , PP.empty
                        , PP.words "geng protobuf --proto-path=proto --output=src proto/shapes/demo.proto"
                            |> PP.indent
                            |> PP.color PP.Green
                        , PP.empty
                        , PP.words
                            """
                            This writes the module Shapes.Demo to src/Shapes/Demo.geng. With --describe
                            it prints every message, enum and field the file declares instead.
                            """
                        ]
                , builder =
                    \args flags -> Protobuf { paths = args, describe = flags.describe, protoPath = flags.protoPath, output = flags.output }
                }
            |> Cli.Parser.withCommand
                { word = "make"
                , arguments =
                    Cli.Parser.zeroOrMoreArgs moduleNameParser
                , flags =
                    Cli.Parser.initFlags 
                        (\optimize sourcemaps output report erlc escript ->
                            { optimize = optimize
                            , sourcemaps = sourcemaps
                            , output = output
                            , report = report
                            , erlc = erlc
                            , escript = escript
                            }
                        )
                        |> Cli.Parser.toggle "optimize" "Turn on optimizations to make code smaller and faster. For example, the compiler renames record fields to be as short as possible and unboxes values to reduce allocation."
                        |> Cli.Parser.toggle "sourcemaps" "Add sourcemaps to the resulting JS file. This let's you debug Gren code in a JS debugger, at the cost of longer compile times and a bigger JS file."
                        |> Cli.Parser.flag "output" outputParser "Specify the name of the file to write. For example --output=assets/gren.js to generate the JS at assets/gren.js. You can also use --output=/dev/stdout to output the JS to the terminal, or --output=/dev/null to generate no output at all! For a project built for the beam target this names the program you run, and the modules go in a directory beside it named after it."
                        |> Cli.Parser.flag "report" reportParser "You can say --report=json to get error messages as JSON. This is only really useful if you are an editor plugin. Humans should avoid it!"
                        |> Cli.Parser.flag "erlc" programParser "The Erlang compiler a beam build runs. Without this I look for GENG_ERLC, and then for erlc on your PATH."
                        |> Cli.Parser.flag "escript" programParser "The escript runner a beam build writes its program with. Without this I look for GENG_ESCRIPT, and then for escript on your PATH."
                , commonDescription =
                    Nothing
                , summary =
                    "The `make` command compiles Geng code into JS, HTML or a BEAM program:"
                , example = 
                    PP.verticalBlock
                        [ PP.words "For example:"
                        , PP.empty
                        , PP.words "geng make Main"
                            |> PP.indent
                            |> PP.color PP.Green
                        , PP.empty
                        , PP.words
                            """
                            This tries to compile a Geng file named src/Main.geng, generating an index.html
                            file if possible.
                            """
                        ]
                , builder =
                    \args flags ->
                        Make
                            { optimize = flags.optimize
                            , sourcemaps = flags.sourcemaps
                            , output = flags.output
                            , report = flags.report
                            , erlc = flags.erlc
                            , escript = flags.escript
                            , entryPoints = args
                            }
                }
            |> Cli.Parser.withCommand
                { word = "release"
                , arguments =
                    Cli.Parser.zeroOrMoreArgs moduleNameParser
                , flags =
                    Cli.Parser.initFlags
                        (\output erlc escript ->
                            { output = output
                            , erlc = erlc
                            , escript = escript
                            }
                        )
                        |> Cli.Parser.flag "output" releaseDirParser "The directory to write the release in, release by default. A directory that already holds an earlier version of the release gets this one beside it, with an appup and a relup that upgrade a running node from the earlier one."
                        |> Cli.Parser.flag "erlc" programParser "The Erlang compiler the build runs. Without this I look for GENG_ERLC, and then for erlc on your PATH."
                        |> Cli.Parser.flag "escript" programParser "The escript runner the build and the release are made with. Without this I look for GENG_ESCRIPT, and then for escript on your PATH."
                , commonDescription =
                    Nothing
                , summary =
                    "The `release` command builds a beam application and makes an OTP release of it:"
                , example =
                    PP.verticalBlock
                        [ PP.words "For example:"
                        , PP.empty
                        , PP.words "geng release Main"
                            |> PP.indent
                            |> PP.color PP.Green
                        , PP.empty
                        , PP.words
                            """
                            This builds the project as geng make does and writes an OTP release in release/: the Erlang runtime, every application the program needs, a boot script, sys.config and vm.args to edit, a tarball to deploy, and bin/NAME to start it with foreground, daemon, stop, ping, eval, remote or upgrade. The project's geng.toml names the application and its version in [application] name and version.
                            """
                        ]
                , builder =
                    \args flags ->
                        Release
                            { output = flags.output
                            , erlc = flags.erlc
                            , escript = flags.escript
                            , entryPoints = args
                            }
                }
            |> Cli.Parser.withCommand
                { word = "run"
                , arguments =
                    Cli.Parser.oneArg moduleNameParser
                , flags =
                    Cli.Parser.initFlags 
                        (\package erlc escript ->
                            { package = package
                            , erlc = erlc
                            , escript = escript
                            }
                        )
                        |> Cli.Parser.flag "package" Cli.Parser.packageNameParser "Run a module in a particular package."
                        |> Cli.Parser.flag "erlc" programParser "The Erlang compiler a beam build runs. Without this I look for GENG_ERLC, and then for erlc on your PATH."
                        |> Cli.Parser.flag "escript" programParser "The escript runner a beam build writes its program with, and runs it with. Without this I look for GENG_ESCRIPT, and then for escript on your PATH."
                , commonDescription =
                    Nothing
                , summary =
                    "The `run` command compiles a Geng module and runs it:"
                , example = 
                    PP.verticalBlock
                        [ PP.words "For example:"
                        , PP.empty
                        , PP.words "geng run Main"
                            |> PP.indent
                            |> PP.color PP.Green
                        , PP.empty
                        , PP.words
                            """
                            This tries to compile a Geng file named src/Main.geng, and then runs what it built.
                            The file must have a `main`. For a project built for the beam target this builds the program the way geng make does, and what runs is the escript.
                            """
                        ]
                , builder =
                    (\arg flags ->
                        Run
                            { moduleName = arg
                            , package = flags.package
                            , erlc = flags.erlc
                            , escript = flags.escript
                            }
                    )
                }
            |> Cli.Parser.withCommand
                { word = "docs"
                , arguments =
                    Cli.Parser.noArgs
                , flags =
                    Cli.Parser.initFlags 
                        (\output report ->
                            { output = output
                            , report = report
                            }
                        )
                        |> Cli.Parser.flag "output" docsOutputParser "Specify the name of the resulting JSON file. For example --output=assets/docs.json to generate the JSON at assets/docs.json. You can also use --output=/dev/stdout to output the JSON to the terminal, or --output=/dev/null to verify that generating the documentation would work."
                        |> Cli.Parser.flag "report" reportParser "You can say --report=json to get error messages as JSON. This is only really useful if you are an editor plugin. Humans should avoid it!"
                , commonDescription =
                    Nothing
                , summary =
                    "The `docs` command collects all documentation for a package in a JSON file:"
                , example = 
                    PP.verticalBlock
                        [ PP.words "For example:"
                        , PP.words "geng docs"
                            |> PP.indent
                            |> PP.color PP.Green
                        , PP.words
                            """
                            This collects all documentation for the current pacage and writes it to a
                            docs.json file, if possible.
                            """
                        ]
                , builder =
                    \_args flags -> Docs flags
                }
            |> Cli.Parser.withPrefix "package" packageCommands
    }


packageCommands : Cli.Parser.GroupParser Command
packageCommands =
    Cli.Parser.defineGroup
        |> Cli.Parser.withCommand
            { word = "install"
            , arguments =
                Cli.Parser.oneOfArgs
                    [ Cli.Parser.noArgs
                        |> Cli.Parser.mapArgs (\_ -> Nothing)
                    , Cli.Parser.oneArg Cli.Parser.packageNameParser
                        |> Cli.Parser.mapArgs Just
                    ]
            , flags =
                Cli.Parser.noFlags 
            , commonDescription =
                Nothing
            , summary =
                "The `install` command fetches packages from github for use in your project:"
            , example = 
                PP.verticalBlock
                    [ PP.words 
                        """
                        For example, if you want to get access to Web APIs in your project,
                        you would say:
                        """
                    , PP.empty
                    , PP.text "geng package install github.com/geng-language/browser"
                        |> PP.indent
                        |> PP.color PP.Green
                    , PP.empty
                    , PP.words
                        """
                        Notice that you must say the AUTHOR name and PROJECT name! After running those
                        commands, you could say `import Browser` in your code.
                        """
                    , PP.empty
                    , PP.words
                        """
                        You can also call this command without any arguments to download all dependencies
                        listed in geng.toml. This can be helpful in Continous Integration setups where
                        you want to cache dependencies between builds.
                        """
                    ]
            , builder =
                \arg _flags ->
                    PackageInstall arg
            }
        |> Cli.Parser.withCommand
            { word = "uninstall"
            , arguments =
                Cli.Parser.oneArg Cli.Parser.packageNameParser
            , flags =
                Cli.Parser.noFlags 
            , commonDescription =
                Nothing
            , summary =
                "The `uninstall` command removes packages from your project:"
            , example = 
                PP.verticalBlock
                    [ PP.words 
                        """
                        For example, if you want to get rid of the browser package in your project,
                        you would say:
                        """
                    , PP.empty
                    , PP.text "geng package uninstall github.com/geng-language/browser"
                        |> PP.indent
                        |> PP.color PP.Green
                    , PP.empty
                    , PP.words 
                        """
                        Notice that you must say the AUTHOR name and PROJECT name!
                        """
                    , PP.empty
                    , PP.words
                        """
                        What if another package depends on the package you're trying to remove? No problem!
                        I'll let you know if that's the case, and help you resolve the situation. 
                        """
                    ]
            , builder =
                \arg _flags -> PackageUninstall arg
            }
        |> Cli.Parser.withCommand
            { word = "outdated"
            , arguments =
                Cli.Parser.noArgs
            , flags =
                Cli.Parser.noFlags 
            , commonDescription =
                Nothing
            , summary =
                "The `outdated` command lists the latest version of your dependencies,"
                    ++ " if you're not already up to date:"
            , example = 
                PP.text "geng package outdated"
                    |> PP.indent
                    |> PP.color PP.Green
            , builder =
                \_args _flags -> PackageOutdated
            }
        |> Cli.Parser.withCommand
            { word = "validate"
            , arguments =
                Cli.Parser.noArgs
            , flags =
                Cli.Parser.noFlags 
            , commonDescription =
                Nothing
            , summary =
                "The `validate` command checks that you've done everything necessary for"
                    ++ " others in the Gren community to use your package as a dependency:"
            , example = 
                PP.verticalBlock
                    [ PP.words 
                        """
                        Gren packages are \"just\" git repositories hosted on github. As
                        long as you've tagged your repository with semver formatted tags,
                        anyone can add your package as a dependency.
                        """
                    , PP.empty
                    , PP.words 
                        """
                        However, a package is no better than its documentation. This command
                        therefore checks that your package exposes a bare minimum of
                        prose that the users of your package can read.
                        """
                    , PP.empty
                    , PP.words
                        """
                        Keep in mind, you don't just want to tell people HOW to use
                        your package. It's equally important to tell them WHY. What
                        problem does it solve? Why should people use this particular
                        package to solve their problem?
                        """
                    , PP.empty
                    , PP.words
                        """
                        Once this command passes, you may want to add your repo to
                        <https://packages.gren-lang.org> so it becomes easier for the Gren
                        community to find your package, and its documentation.
                        """
                    ]
            , builder =
                \_args _flags -> PackageValidate
            }
        |> Cli.Parser.withCommand
            { word = "bump"
            , arguments =
                Cli.Parser.noArgs
            , flags =
                Cli.Parser.noFlags 
            , commonDescription =
                Nothing
            , summary =
                "The `bump` command figures out the next version number based on API changes:"
            , example = 
                PP.words 
                    """
                    Say you just published version 1.0.0, but then decided to remove a function.
                    I will compare the published API to what you have locally, figure out that
                    it is a MAJOR change, and bump your version number to 2.0.0. I do this with
                    all packages, so there cannot be MAJOR changes hiding in PATCH releases in Gren!
                    """
            , builder =
                \_args _flags -> PackageBump
            }
        |> Cli.Parser.withCommand
            { word = "diff"
            , arguments =
                Cli.Parser.oneOfArgs
                    [ Cli.Parser.noArgs
                        |> Cli.Parser.mapArgs (\{} -> DiffLatest)
                    , Cli.Parser.oneArg Cli.Parser.semanticVersionParser
                        |> Cli.Parser.mapArgs DiffVersion
                    , Cli.Parser.twoArgs
                        (\lower upper ->
                            DiffRange
                                { lower = lower
                                , upper = upper
                                }
                        )
                        Cli.Parser.semanticVersionParser
                        Cli.Parser.semanticVersionParser
                    , Cli.Parser.threeArgs
                        (\package lower upper ->
                            DiffGlobal
                                { package = package
                                , lower = lower
                                , upper = upper
                                }
                        )
                        Cli.Parser.packageNameParser
                        Cli.Parser.semanticVersionParser
                        Cli.Parser.semanticVersionParser
                    ]
            , flags =
                Cli.Parser.noFlags 
            , commonDescription =
                Nothing
            , summary =
                "The `diff` command detects API changes:"
            , example = 
                PP.verticalBlock
                    [ PP.words 
                        """
                        For example, to see what changed in the Browser package between
                        versions 1.0.0 and 2.0.0, you can say:
                        """
                    , PP.empty
                    , PP.text "geng package diff github.com/geng-language/browser 1.0.0 2.0.0"
                        |> PP.indent
                        |> PP.color PP.Green
                    , PP.empty
                    , PP.words 
                        """
                        Sometimes a MAJOR change is not actually very big, so
                        this can help you plan your upgrade timelines.
                        """
                    ]
            , builder =
                \args _flags -> PackageDiff args
            }


initPlatformParser : Cli.Parser.ValueParser Platform
initPlatformParser =
    { singular = "platform"
    , plural = "platforms"
    , fn = \str ->
        when str is
            "common" -> Just Platform.Common
            "browser" -> Just Platform.Browser
            "node" -> Just Platform.Node
            _ -> Nothing
    , examples =
        [ "common"
        , "browser"
        , "node"
        ]
    }


reportParser : Cli.Parser.ValueParser {}
reportParser =
    { singular = "report-type"
    , plural = "report-types"
    , fn = \str ->
        if str == "json" then
            Just {}

        else
            Nothing
    , examples =
        [ "json" ]
    }


{-| A program to run: a name this build looks for on `PATH`, or a path to one.

`erlc` and `escript` are what a `beam` build needs and the compiler does not
carry (`m2-beam.md` §BM24, D390). A name with no separator in it is resolved on
`PATH`, which is what makes the bare default work, and either form is accepted
here so that `--erlc=erlc-27` is as good as an absolute path.
-}
releaseDirParser : Cli.Parser.ValueParser String
releaseDirParser =
    { singular = "directory"
    , plural = "directories"
    , fn = Just
    , examples =
        [ "release"
        , "_build/release"
        ]
    }


programParser : Cli.Parser.ValueParser String
programParser =
    { singular = "program"
    , plural = "programs"
    , fn = Just
    , examples =
        [ "erlc"
        , "/usr/lib/erlang/bin/erlc"
        ]
    }


outputParser : Cli.Parser.ValueParser Compiler.Backend.MakeOutput
outputParser =
    { singular = "output-file"
    , plural = "output-files"
    , fn = \str ->
        when str is
            "/dev/stdout" -> Just Compiler.Backend.StdOut
            "/dev/null" -> Just Compiler.Backend.DevNull
            "NUL" -> Just Compiler.Backend.DevNull
            "$null" -> Just Compiler.Backend.DevNull
            _ ->
                if String.endsWith ".html" str then
                    Just <| Compiler.Backend.Html str
                
                else if String.endsWith ".js" str then
                    Just <| Compiler.Backend.Js str

                else
                    Just <| Compiler.Backend.Exe str
    , examples =
        [ "/dev/stdout"
        , "/dev/null"
        , "index.html"
        , "index.js"
        , "app"
        ]
    }


docsOutputParser : Cli.Parser.ValueParser Compiler.Backend.DocsOutput
docsOutputParser =
    { singular = "output-file"
    , plural = "output-files"
    , fn = \str ->
        when str is
            "/dev/stdout" -> Just Compiler.Backend.DocsStdOut
            "/dev/null" -> Just Compiler.Backend.DocsDevNull
            "NUL" -> Just Compiler.Backend.DocsDevNull
            "$null" -> Just Compiler.Backend.DocsDevNull
            _ ->
                if String.endsWith ".json" str then
                    Just <| Compiler.Backend.DocsJson str

                else
                    Nothing
    , examples =
        [ "/dev/stdout"
        , "/dev/null"
        , "docs.json"
        ]
    }


moduleNameParser : Cli.Parser.ValueParser ModuleName
moduleNameParser =
    { singular = "module-name"
    , plural = "module-names"
    , fn = ModuleName.fromString
    , examples =
        [ "Main"
        , "My.Module"
        ]
    }
