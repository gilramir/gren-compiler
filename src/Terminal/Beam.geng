module Terminal.Beam exposing
    ( Plan
    , Toolchain
    , Config
    , Identity
    , identity
    , isTarget
    , plan
    , paths
    , toolchain
    , libraries
    , libraryEnvironment
    , stageEnvironment
    , prepare
    , abandon
    , build
    , forgetProgram
    , requireProgram
    , releaseIdentity
    , release
    )

{-| The BEAM half of `geng make`, for a project whose outline says
`target = "beam"`.

The backend for that target is not in the compiler binary: it is
`packages/beam-backend`, a Geng package this front end imports (D382). So a `beam`
build is this process running the binary with `GENG_STAGE_WRITE=passed:dir`,
which stops it after the passes with the program's Core in a directory, and
then everything else here — one command for the person who typed it, and the
seam `m2-seam.md` §DS5 built underneath (geng-lang `m2-beam.md` §BM23, §BM24).

    geng make Main                  the binary, and then
      app.otp/src/*.erl             linked and emitted
      app.otp/src/geng_rt.erl, ...  the runtime, which this compiler carries
      app.otp/ebin/*.beam           erlc, over those and each package's Ext
      app.otp/src/ext/*.erl         each package's Ext, copied in for rebar3
      app.otp/ebin/<name>.app       the OTP application resource file
      app.otp/rebar.config          so rebar3 and mix can build it from src
      app                           the escript, which is what a person runs

A build of modules none of which has a `main` is a library, and stops at
`app.otp/`: its roots are the modules' exposed values, for Erlang to call
(D399, `m2-interop.md` §EI13).

**What a build leaves.** `--output` names the file a person runs, `app` by
default, as it does for the Node platform; the modules go in a directory beside
it named after it, because a BEAM program is a set of modules and OTP interop,
a release and `erl -pa` all want the directory rather than the one file (D384,
D388). **The directory is an OTP application** (D433, `m2-otp-app.md` §OA8):
`ebin/` and `src/` as every BEAM build tool lays one out, and the whole build
is the one application, named by the manifest's `name` and `version` (D432).
`<output>.otp/geng-build/` is the build's own scratch — the passed Core and the
build's Erlang tools — and it goes when the build succeeds.

-}

import Bytes exposing (Bytes)
import ChildProcess
import Cli.PrettyPrinter as PP
import Cli.Report as Report exposing (Report)
import Compiler.Backend
import Compiler.Outline as Outline exposing (Outline)
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Geng.Beam.Build as Build
import Geng.Beam.Runtime as Runtime
import Geng.Core as Core
import SemanticVersion
import Stream
import Stream.Log
import Task exposing (Task)


{-| Whether this project is built for the `beam` target, which is what sends
a `geng make` or a `geng run` through this module.

A package has no target of its own to build for — its `[platform] target` is
what its externs serve, which is a different question (D318) — and `geng make`
in one generates nothing anyway.
-}
isTarget : Outline -> Bool
isTarget outline =
    when outline is
        Outline.App app ->
            app.target == "beam"

        Outline.Pkg _ ->
            False


{-| Where a BEAM build's things go.
-}
type alias Plan =
    { escript : Path
    , otp : Path
    , ebin : Path
    , src : Path
    , work : Path
    , stage : Path
    }


{-| The OTP application a build is: its name, an Erlang atom, and its version
(D432).
-}
type alias Identity =
    { name : String
    , version : String
    , supervisor : Maybe String
    }


{-| The manifest's `name` and `version`, or the output's name made an atom and
`0.0.0` for a manifest that has neither (D432). A release asks for both
itself, since a release's version is what an upgrade is from.
-}
identity : Plan -> Outline -> Identity
identity thePlan outline =
    let
        fromOutput =
            atomOf (Path.filenameWithExtension thePlan.escript)
    in
    when outline is
        Outline.App app ->
            { name = Maybe.withDefault fromOutput app.name
            , version = Maybe.map SemanticVersion.toString app.version |> Maybe.withDefault "0.0.0"
            , supervisor = Maybe.map (\m -> "app@" ++ String.replace "." "@" m) app.supervisor
            }

        Outline.Pkg _ ->
            { name = fromOutput, version = "0.0.0", supervisor = Nothing }


{-| D437 · what `geng release` needs of the manifest: a `beam` application
that names itself, since a release's name and version are what an upgrade is
from and to, and a default taken from the output would change with it.
-}
releaseIdentity : Outline -> Result Report { name : String, version : String }
releaseIdentity outline =
    let
        refuse why =
            Err <|
                Report.create
                    "A RELEASE NEEDS A NAME AND A VERSION"
                    Nothing
                    (PP.verticalBlock
                        [ PP.words why
                        , PP.empty
                        , PP.words "Give the application both in geng.toml's [application] table, as name = \"grid\" and version = \"1.0.0\": the name is the release's and its application's, and the version is what an upgrade goes from and to (m2-otp-app.md D432, D437)."
                        ]
                    )
    in
    when outline is
        Outline.App app ->
            if app.target /= "beam" then
                refuse ("geng release makes an OTP release, and this project's target is " ++ app.target ++ ".")

            else
                when { name = app.name, version = app.version } is
                    { name = Just name, version = Just version } ->
                        Ok { name = name, version = SemanticVersion.toString version }

                    _ ->
                        refuse "This application's geng.toml does not say both what it is called and which version it is."

        Outline.Pkg _ ->
            refuse "geng release makes a release of an application, and this project is a package."


{-| D437, D438 · the release, from the application a build just wrote in
`thePlan.otp`, in `directory`: `Runtime.releaseWriter` with OTP's `systools`
makes the `.rel`, the boot script, the tarball and the start script, and, when
the directory already holds earlier versions, the appup and relup that upgrade
a running node from them.
-}
release : Config -> Plan -> Path -> Task Report {}
release config thePlan directory =
    let
        writer =
            Path.append (Path.fromPosixString Runtime.releaseWriter.name) thePlan.otp
    in
    FileSystem.writeFile config.fs (Bytes.fromString Runtime.releaseWriter.text) writer
        |> Task.mapError (failure "I cannot write the release writer")
        |> Task.andThen
            (\_ ->
                spawn config
                    config.tools.escript
                    "GENG_ESCRIPT"
                    "--escript"
                    (\_ ->
                        Report.create
                            "THE RELEASE CANNOT BE MADE"
                            Nothing
                            (PP.verticalBlock
                                [ PP.words "The application is built, and its release could not be made, as the lines above say."
                                , PP.empty
                                , PP.words "geng release uses OTP's own systools, so what it refuses is what an Erlang release of the same applications would be refused for (m2-otp-app.md D437)."
                                ]
                            )
                    )
                    [ config.toString writer
                    , config.toString thePlan.otp
                    , config.identity.name
                    , config.identity.version
                    , config.toString directory
                    ]
            )
        |> Task.andThen
            (\_ ->
                FileSystem.remove config.fs { recursive = False } writer
                    |> Task.map (\_ -> {})
                    |> Task.onError (\_ -> Task.succeed {})
            )


{-| A file name as an atom that needs no quotes: lower-cased, anything but a
letter, digit or underscore an underscore, and `geng_` before one that does not
start with a letter.
-}
atomOf : String -> String
atomOf name =
    let
        lowered =
            String.toLower name
                |> String.map
                    (\c ->
                        if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' then
                            c

                        else
                            '_'
                    )
    in
    when String.popFirst lowered is
        Just { first } ->
            if first >= 'a' && first <= 'z' then
                lowered

            else
                "geng_" ++ lowered

        Nothing ->
            "app"


{-| The two programs a BEAM build runs and this compiler does not carry.
-}
type alias Toolchain =
    { erlc : String
    , escript : String
    }


{-| The plan for an `--output`, or why there is none.

`/dev/null` asks for no output at all, and answers `Nothing`: the compiler
serves it by never reaching a backend, so such a build is the ordinary one and
nothing here runs. The three that are refused are refused because they name a
JavaScript artifact — a BEAM program is neither a stream of text nor a page.
-}
plan : (String -> Path) -> Maybe Compiler.Backend.MakeOutput -> Result Report (Maybe Plan)
plan fromString output =
    let
        refuse what instead =
            Err <|
                Report.create
                    "THAT OUTPUT IS NOT A BEAM PROGRAM"
                    Nothing
                    (PP.verticalBlock
                        [ PP.words
                            ("You have asked for " ++ what ++ ", but this project's target is beam.")
                        , PP.empty
                        , PP.words instead
                        ]
                    )
    in
    when output is
        Nothing ->
            Ok (Just (paths (fromString "app")))

        Just (Compiler.Backend.Exe path) ->
            Ok (Just (paths (fromString path)))

        Just Compiler.Backend.StdOut ->
            refuse
                "the program on standard output"
                "A BEAM program is a set of compiled modules and an escript around them, so there is nothing to print. Give me a file name instead."

        Just (Compiler.Backend.Js path) ->
            refuse
                ("JavaScript at " ++ path)
                "Drop the .js from --output and I will write a BEAM program there."

        Just (Compiler.Backend.Html path) ->
            refuse
                ("an HTML page at " ++ path)
                "A page needs the js target and the browser platform."

        Just Compiler.Backend.DevNull ->
            Ok Nothing


paths : Path -> Plan
paths escriptPath =
    let
        otp =
            Path.append
                (Path.fromPosixString (Path.filenameWithExtension escriptPath ++ ".otp"))
                (Path.parentPath escriptPath |> Maybe.withDefault Path.empty)

        work =
            Path.append (Path.fromPosixString "geng-build") otp
    in
    { escript = escriptPath
    , otp = otp
    , ebin = Path.append (Path.fromPosixString "ebin") otp
    , src = Path.append (Path.fromPosixString "src") otp
    , work = work
    , stage = Path.append (Path.fromPosixString "stage") work
    }


{-| Where `erlc` and `escript` come from: **the flag, then the environment,
then the bare name on `PATH`** (D390).

A name with no separator in it is what a spawn resolves on `PATH`, so the
default needs no lookup of its own. The environment layer is there because a
toolchain is a property of the machine and not of the project — which is also
why there is no `geng.toml` key for it, a committed file being the wrong place
for one machine's paths — and `GENG_BIN` is the precedent.
-}
toolchain : Dict String String -> { erlc : Maybe String, escript : Maybe String } -> Toolchain
toolchain envVars flags =
    { erlc = chosen flags.erlc (Dict.get "GENG_ERLC" envVars) "erlc"
    , escript = chosen flags.escript (Dict.get "GENG_ESCRIPT" envVars) "escript"
    }


chosen : Maybe String -> Maybe String -> String -> String
chosen flag fromEnv fallback =
    when flag is
        Just given ->
            given

        Nothing ->
            Maybe.withDefault fallback fromEnv


{-| What the compiler binary is run with, so that it stops after the passes and
leaves this process the Core.

**A build refuses to start when either switch is already set**, rather than
overriding it: `GENG_STAGE_WRITE` is a developer's switch as much as this
build's (`Core.Stage`), and silently taking it over would make a staged run of
a `beam` project write somewhere the person did not ask for.
-}
stageEnvironment : (Path -> String) -> Dict String String -> Plan -> Result Report (Dict String String)
stageEnvironment toString envVars thePlan =
    let
        taken name =
            Err <|
                Report.create
                    "THE STAGE IS ALREADY SET"
                    Nothing
                    (PP.verticalBlock
                        [ PP.words
                            (name ++ " is set in this environment, and a build for the beam target sets GENG_STAGE_WRITE itself: the backend is not in the compiler binary, so the build stops at the passed Core and finishes here.")
                        , PP.empty
                        , PP.words "Unset it, or build this project for the js target."
                        ]
                    )
    in
    if Dict.member "GENG_STAGE_WRITE" envVars then
        taken "GENG_STAGE_WRITE"

    else if Dict.member "GENG_STAGE_READ" envVars then
        taken "GENG_STAGE_READ"

    else
        Ok (Dict.singleton "GENG_STAGE_WRITE" ("passed:" ++ toString thePlan.stage))


{-| The build's scratch directory, made afresh, and nothing else touched.

**The last good build stays until this one has something to replace it**
(geng-lang `m2-interop.md` §EI18). A build the compiler refuses, for a type
error or anything else, leaves `<output>.otp/`'s modules and the escript as
the previous build wrote them, and `abandon` takes the scratch away. The
modules are cleared in `buildStage`, once the backend has emitted a program.

The scratch is emptied first because the compiler writes its stage into it,
and a stage an earlier build left there, from a different program, would
otherwise be read as this one's.
-}
prepare : FileSystem.Permission -> Plan -> Task Report {}
prepare fs thePlan =
    removeWork fs thePlan
        |> Task.andThen
            (\_ ->
                FileSystem.makeDirectory fs { recursive = True } thePlan.work
                    |> Task.mapError (failure "I cannot make the output directory")
            )
        |> Task.map (\_ -> {})


{-| A build that stops before it has a program: its scratch goes, and the
last good build is left as it was.
-}
abandon : FileSystem.Permission -> Plan -> Task Report {}
abandon fs thePlan =
    removeWork fs thePlan


removeWork : FileSystem.Permission -> Plan -> Task Report {}
removeWork fs thePlan =
    FileSystem.remove fs { recursive = True } thePlan.work
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


{-| An output directory made if it is not there, and emptied of the files an
earlier build left, those whose names end with one of `endings`.

A program's modules are the program's, and a module left behind from a
different one would be compiled into this one's directory and shipped in its
archive, or listed in its `.app`. The `geng-build` directory beside them is the
build's own and is left alone here.
-}
clear : FileSystem.Permission -> Array String -> Path -> Task Report {}
clear fs endings directory =
    FileSystem.makeDirectory fs { recursive = True } directory
        |> Task.mapError (failure "I cannot make the output directory")
        |> Task.andThen
            (\_ ->
                FileSystem.listDirectory fs directory
                    |> Task.mapError (failure "I cannot read the output directory")
            )
        |> Task.andThen
            (\entries ->
                entries
                    |> Array.map (\entry -> Path.filenameWithExtension entry.path)
                    |> Array.keepIf (\name -> Array.any (\ending -> String.endsWith ending name) endings)
                    |> Array.map
                        (\name ->
                            FileSystem.remove fs
                                { recursive = False }
                                (Path.append (Path.fromPosixString name) directory)
                                |> Task.mapError (failure "I cannot clear the output directory")
                        )
                    |> Task.sequence
            )
        |> Task.map (\_ -> {})


{-| `geng run`'s escript removed before it builds, so that what it runs
afterwards is this build's or nothing.

`geng run` runs whatever is at its output path, and a module with no `main`
builds as a library and writes no escript there (D399, `m2-interop.md`
§EI13), so without this a library build would run the program an earlier
`geng run` left. The path is `.gren/`'s and the compiler's own, which is why
this may remove it where a library build given `--output` does not.
-}
forgetProgram : FileSystem.Permission -> Path -> Task Report {}
forgetProgram fs path =
    FileSystem.remove fs { recursive = False } path
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


{-| That a `geng run` build left a program to run, or `NO MAIN`.

Before D399 the compiler refused a module with no `main` itself; now that is
a library, and a library is a build `geng make` makes and nothing runs.
-}
requireProgram : FileSystem.Permission -> String -> Path -> Task Report {}
requireProgram fs moduleName path =
    FileSystem.checkAccess fs [] path
        |> Task.map (\_ -> {})
        |> Task.onError
            (\_ ->
                Task.fail <|
                    Report.create
                        "NO MAIN"
                        Nothing
                        (PP.verticalBlock
                            [ PP.words
                                ("geng run runs a program, and " ++ moduleName ++ " has no `main`, so for the beam target it builds as a library: its exposed values, for Erlang to call.")
                            , PP.empty
                            , PP.words
                                ("To build the library, use geng make " ++ moduleName ++ ". To run it, give it a `main`, which is a `Task Never {}`.")
                            ]
                        )
            )


{-| What a build needs that is not in its `Plan`.

`packages` is every root a package of this build has — the project's own, and
every dependency's, `core` among them — because an `erlang` extern's
implementation is `src/Ext/<module>.erl` in the package that declares it
(`ffi.md` F1), and `erlc` has to be given all of them.
-}
type alias Config =
    { fs : FileSystem.Permission
    , cp : ChildProcess.Permission
    , stderr : Stream.Writable Bytes
    , toString : Path -> String
    , tools : Toolchain
    , packages : Array Path
    , libraries : Array Path
    , environment : Dict String String
    , identity : Identity
    }


{-| D418 · an application's `erlang-libraries`, each joined to the project's
directory. A package has none: what a program links against is the
application's to say (geng-lang `m2-interop.md` §EI21).
-}
libraries : Path -> Outline -> Array Path
libraries projectPath outline =
    when outline is
        Outline.App app ->
            Array.map (\library -> Path.append library projectPath) app.erlangLibraries

        Outline.Pkg _ ->
            []


{-| What `erlc`, D413's check and `geng run`'s escript are started with for
the libraries to be found: `ERL_LIBS`, the libraries first and then whatever
the environment already has there, which is how OTP's code server finds an
application's `ebin` and `erlc` a behaviour or an `-include_lib`. Nothing is
set when there are none, so a build that sets `ERL_LIBS` itself is as it was.
-}
libraryEnvironment : (Path -> String) -> Dict String String -> Array Path -> Dict String String
libraryEnvironment toString envVars directories =
    if Array.isEmpty directories then
        Dict.empty

    else
        Dict.singleton "ERL_LIBS"
            (String.join ":"
                (Array.map toString directories
                    ++ (when Dict.get "ERL_LIBS" envVars is
                            Just inherited ->
                                if inherited == "" then
                                    []

                                else
                                    [ inherited ]

                            Nothing ->
                                []
                       )
                )
            )


{-| The stage directory turned into the two artifacts D384 asks for, and the
status that answers.

**A build that wrote no stage wrote no program**, and that is not an error:
`--output=/dev/null` asks for none. So a missing directory is a silent 0.

**A program with no `main` is a library** (D399, `m2-interop.md` §EI13): the
modules its roots reach and the runtime, compiled into the `.ebin` directory
for an Erlang program to load, and no escript, since there is nothing to run.
The escript's path is left alone rather than cleared, because a library's
`--output` names nothing it writes there.

**A shape the backend has no Erlang for is written verbatim** on `stderr`, and
not as one of the compiler's reports. It is not a problem with the program: it
is this backend being unfinished, it names bindings whose specialized names are
longer than a line, and reflowing that list would make it unreadable and
unparseable both (`m2-beam.md` §BM20.3's item 7 is the list of shapes that are
left). It goes when the list does.
-}
build : Config -> Plan -> Task Report Int
build config thePlan =
    FileSystem.checkAccess config.fs [] thePlan.stage
        |> Task.map (\_ -> True)
        |> Task.onError (\_ -> Task.succeed False)
        |> Task.andThen
            (\staged ->
                if staged then
                    buildStage config thePlan

                else
                    Task.succeed 0
            )


buildStage : Config -> Plan -> Task Report Int
buildStage config thePlan =
    read config.fs thePlan.stage
        |> Task.andThen
            (\files ->
                when
                    Build.link Core.ExternErlang files
                        |> Result.andThen (\program -> Result.map (\emitted -> { program = program, emitted = emitted }) (Build.emit program))
                is
                    Err why ->
                        Stream.Log.string config.stderr why
                            |> Task.onError (\_ -> Task.succeed {})
                            |> Task.andThen (\_ -> abandon config.fs thePlan)
                            |> Task.map (\_ -> 1)

                    Ok built ->
                        clear config.fs [ ".beam", ".app" ] thePlan.ebin
                            |> Task.andThen (\_ -> clear config.fs [ ".erl", ".app.src" ] thePlan.src)
                            |> Task.andThen (\_ -> clear config.fs [ ".erl" ] (extCopies thePlan))
                            |> Task.andThen (\_ -> write config.fs thePlan.src (built.emitted ++ Runtime.sources))
                            |> Task.andThen (\_ -> requireLibraries config)
                            |> Task.andThen (\_ -> externSources config)
                            |> Task.andThen
                                (\externs ->
                                    distinctExterns config externs
                                        |> Task.andThen (\_ -> erlc config thePlan externs)
                                        |> Task.andThen (\_ -> checkExterns config thePlan externs (Build.erlangCalls built.program))
                                        |> Task.andThen (\_ -> copyExterns config thePlan externs)
                                )
                            |> Task.andThen
                                (\_ ->
                                    application config
                                        thePlan
                                        (if Array.length built.program.mains == 0 then
                                            "library"

                                         else
                                            "main"
                                        )
                                )
                            |> Task.andThen
                                (\_ ->
                                    if Array.length built.program.mains == 0 then
                                        Task.succeed {}

                                    else
                                        escript config thePlan
                                )
                            |> Task.andThen
                                (\_ ->
                                    FileSystem.remove config.fs { recursive = True } thePlan.work
                                        |> Task.mapError (failure "I cannot remove the build directory")
                                )
                            |> Task.map (\_ -> 0)
            )


write : FileSystem.Permission -> Path -> Array { name : String, text : String } -> Task Report {}
write fs directory files =
    files
        |> Array.map
            (\file ->
                FileSystem.writeFile fs
                    (Bytes.fromString file.text)
                    (Path.append (Path.fromPosixString (erlName file.name)) directory)
                    |> Task.mapError (failure "I cannot write the Erlang")
            )
        |> Task.sequence
        |> Task.map (\_ -> {})


{-| An emitted module is named without an extension and the runtime's carry
their own, the runtime's names being file names in `packages/beam-backend/runtime`.
-}
erlName : String -> String
erlName name =
    if String.endsWith ".erl" name then
        name

    else
        name ++ ".erl"


{-| Every `src/Ext/*.erl` a package of this build has (`ffi.md` F1).

A package with no `src/Ext` contributes nothing and is not an error, which is
almost every package: the directory is absent far more often than it is empty.
A file is listed once however many times its package is: `packages` can name a
root twice, and a file given to `erlc` twice would look to D413's check like two
packages with one module.
-}
externSources : Config -> Task Report (Array Path)
externSources config =
    config.packages
        |> Array.map
            (\root ->
                let
                    directory =
                        Path.append (Path.fromPosixString "Ext")
                            (Path.append (Path.fromPosixString "src") root)
                in
                FileSystem.listDirectory config.fs directory
                    |> Task.map
                        (\entries ->
                            entries
                                |> Array.map (\entry -> Path.filenameWithExtension entry.path)
                                |> Array.keepIf (String.endsWith ".erl")
                                |> Array.sort
                                |> Array.map (\name -> Path.append (Path.fromPosixString name) directory)
                        )
                    |> Task.onError (\_ -> Task.succeed [])
            )
        |> Task.sequence
        |> Task.map (Array.flatten >> Array.foldl (\path acc -> if Array.member path acc then acc else Array.pushLast path acc) [])


{-| An extern module's name: its file's, less `.erl`. -}
externModule : Path -> String
externModule path =
    Path.filenameWithExtension path
        |> String.dropLast 4


{-| D413 · every `src/Ext` module a build compiles has a name no other module in
it has. Two packages that each carry `src/Ext/<name>.erl` compile into one
`.beam`, the later over the earlier, and one package's externs would call the
other's code; one named like a module of the runtime would replace the
runtime. Each is refused before `erlc` runs, naming both files.
-}
distinctExterns : Config -> Array Path -> Task Report {}
distinctExterns config externs =
    let
        runtime =
            Array.pushFirst "geng_main" (Array.map (\file -> String.dropLast 4 file.name) Runtime.sources)

        clashes =
            externs
                |> Array.indexedMap (\i path -> { i = i, path = path })
                |> Array.mapAndKeepJust
                    (\entry ->
                        let
                            name =
                                externModule entry.path
                        in
                        if Array.member name runtime then
                            Just
                                [ "    " ++ shown config entry.path
                                , "        is named like the BEAM runtime's own " ++ name ++ ".erl"
                                ]

                        else
                            externs
                                |> Array.takeFirst entry.i
                                |> Array.findFirst (\earlier -> externModule earlier == name)
                                |> Maybe.map
                                    (\found ->
                                        [ "    " ++ shown config found.value
                                        , "    " ++ shown config entry.path
                                        , "        are both " ++ name
                                        ]
                                    )
                    )
    in
    if Array.isEmpty clashes then
        Task.succeed {}

    else
        Task.fail <|
            Report.create
                "EXTERN MODULES COLLIDE"
                Nothing
                (PP.verticalBlock
                    [ PP.words "An `erlang` extern's module is its file's name, and Erlang has one module of a name in a node, so these would replace each other:"
                    , PP.empty
                    , PP.verticalBlock (Array.map PP.text (Array.flatten clashes))
                    , PP.empty
                    , PP.words "Name each package's modules for the package, as `core`'s are geng_core_console and geng_core_time (D387)."
                    ]
                )


{-| A file, relative to the project when it is the project's, which is the
first of `packages`. -}
shown : Config -> Path -> String
shown config path =
    let
        full =
            config.toString path
    in
    when Array.first config.packages is
        Just project ->
            let
                root =
                    config.toString project ++ "/"
            in
            if String.startsWith root full then
                String.dropFirst (String.count root) full

            else
                full

        Nothing ->
            full


{-| D413 · each `erlang` row calls a function that is there: exported, at the
arity D387 gives the row, by a module of the build's `src/Ext` or of
Erlang/OTP, and no `src/Ext` module has an OTP module's name. Only a node can
say which modules OTP has, so `Runtime.externChecker` asks one, with the
modules `erlc` just wrote first on its code path, and writes each problem on
our standard error.
-}
checkExterns : Config -> Plan -> Array Path -> Array { extern : String, module_ : String, fn : String, arity : Int } -> Task Report {}
checkExterns config thePlan externs calls =
    let
        checker =
            Path.append (Path.fromPosixString Runtime.externChecker.name) thePlan.work

        words =
            calls
                |> Array.sortBy (\c -> c.extern)
                |> Array.map (\c -> [ c.extern, c.module_, c.fn, String.fromInt c.arity ])
                |> Array.flatten
    in
    FileSystem.writeFile config.fs (Bytes.fromString Runtime.externChecker.text) checker
        |> Task.mapError (failure "I cannot write the extern checker")
        |> Task.andThen
            (\_ ->
                spawn config
                    config.tools.escript
                    "GENG_ESCRIPT"
                    "--escript"
                    (\_ ->
                        Report.create
                            "ERLANG EXTERNS DO NOT RESOLVE"
                            Nothing
                            (PP.verticalBlock
                                [ PP.words "The program is compiled, and its `erlang` externs do not all call what they name, as the lines above say."
                                , PP.empty
                                , PP.words "An `erlang` row names a module of a package's `src/Ext`, or of Erlang/OTP, and a function it exports at the row's arity; a `src/Ext` module may not take the name of one of Erlang/OTP's (ffi.md F1, D387, D413)."
                                ]
                            )
                    )
                    ([ config.toString checker, config.toString thePlan.ebin ]
                        ++ Array.map externModule externs
                        ++ [ "--" ]
                        ++ words
                    )
            )


{-| D418 · every `erlang-libraries` directory is there. `ERL_LIBS` skips one
that is not, so a mistyped path would otherwise be an `erlc` warning about
an undefined behaviour, or an extern D413 cannot find, naming neither.
-}
requireLibraries : Config -> Task Report {}
requireLibraries config =
    config.libraries
        |> Array.map
            (\library ->
                FileSystem.checkAccess config.fs [] library
                    |> Task.map (\_ -> [])
                    |> Task.onError (\_ -> Task.succeed [ library ])
            )
        |> Task.sequence
        |> Task.andThen
            (\found ->
                when Array.flatten found is
                    [] ->
                        Task.succeed {}

                    missing ->
                        Task.fail
                            (Report.create
                                "AN ERLANG LIBRARY DIRECTORY IS MISSING"
                                Nothing
                                (PP.verticalBlock
                                    [ PP.words "The geng.toml's erlang-libraries names directories that are not there:"
                                    , PP.empty
                                    , PP.indent (PP.verticalBlock (Array.map (\path -> PP.words (config.toString path)) missing))
                                    , PP.empty
                                    , PP.words "Each is a directory of OTP applications, as ERL_LIBS has them, such as rebar3's _build/default/lib once rebar3 has fetched and compiled them (m2-interop.md D418)."
                                    ]
                                )
                            )
            )


{-| Each package's `src/Ext/*.erl` copied into the application's `src/ext/`,
once `erlc` has compiled it from where it is, so that its diagnostics name the
package's own file. A build tool that compiles the application from source,
`rebar3` or `mix`, needs every module's Erlang under `src/`, which it reads
recursively, and a build keeps the emitted modules' and the runtime's already
(D433). They are a directory down so that `src/*.erl` stays what it was, the
emitted modules and the runtime, and a package's module is not read twice by
anything that also reads the package.
-}
copyExterns : Config -> Plan -> Array Path -> Task Report {}
copyExterns config thePlan externs =
    externs
        |> Array.map
            (\path ->
                FileSystem.copyFile config.fs
                    (Path.append (Path.fromPosixString (Path.filenameWithExtension path)) (extCopies thePlan))
                    path
                    |> Task.mapError (failure "I cannot copy an extern's Erlang into the application")
            )
        |> Task.sequence
        |> Task.map (\_ -> {})


extCopies : Plan -> Path
extCopies thePlan =
    Path.append (Path.fromPosixString "ext") thePlan.src


{-| D433 · the application's resource file, `ebin/<name>.app` and
`src/<name>.app.src`, written by `Runtime.appWriter` once `erlc` has written
every module, since the applications it needs are computed from their imports
on this node's code path; and a `rebar.config`, so that `rebar3` and `mix`
take the directory as an application to build from `src`.
-}
application : Config -> Plan -> String -> Task Report {}
application config thePlan start =
    let
        writer =
            Path.append (Path.fromPosixString Runtime.appWriter.name) thePlan.work
    in
    FileSystem.writeFile config.fs (Bytes.fromString Runtime.appWriter.text) writer
        |> Task.mapError (failure "I cannot write the application writer")
        |> Task.andThen
            (\_ ->
                spawn config
                    config.tools.escript
                    "GENG_ESCRIPT"
                    "--escript"
                    (\_ ->
                        Report.create
                            "THE APPLICATION CANNOT BE WRITTEN"
                            Nothing
                            (PP.verticalBlock
                                [ PP.words "The program is compiled, and its OTP application resource file could not be written, as the lines above say."
                                , PP.empty
                                , PP.words "A beam build is one OTP application, named by geng.toml's [application] name, or after --output when it has none (m2-otp-app.md D432, D433)."
                                ]
                            )
                    )
                    [ config.toString writer
                    , config.toString thePlan.ebin
                    , config.toString thePlan.src
                    , config.identity.name
                    , config.identity.version
                    , start
                    , Maybe.withDefault "none" config.identity.supervisor
                    ]
            )
        |> Task.andThen
            (\_ ->
                FileSystem.writeFile config.fs
                    (Bytes.fromString rebarConfig)
                    (Path.append (Path.fromPosixString "rebar.config") thePlan.otp)
                    |> Task.mapError (failure "I cannot write rebar.config")
            )
        |> Task.map (\_ -> {})


{-| What `rebar3` needs to build the application from `src`, which is nothing
but that it is one: every module's Erlang is plain Erlang, the generated ones
included, and the build compiled it without `debug_info` (see `erlc`).
-}
rebarConfig : String
rebarConfig =
    "%% Written by geng make: this directory is a Geng build, one OTP application\n"
        ++ "%% (m2-otp-app.md D433). src/ holds every module's Erlang.\n"
        ++ "{erl_opts, []}.\n"


{-| `erlc` over the Erlang in the output directory and each package's.

**No `+debug_info`**, which is measured and not assumed: over
`accept/prim-coverage`'s 42 modules it is 725,988 bytes of `.beam` against
379,880 without, so it doubles what a user ships for something no one reads
yet. `harness/beam.py` keeps it for the runtime it compiles, because D386's
`dialyzer` will want it there; a build that wants it here can have a flag when
there is something to point at the result.
-}
erlc : Config -> Plan -> Array Path -> Task Report {}
erlc config thePlan externs =
    FileSystem.listDirectory config.fs thePlan.src
        |> Task.mapError (failure "I cannot read the output directory")
        |> Task.andThen
            (\entries ->
                let
                    sources =
                        entries
                            |> Array.map (\entry -> Path.filenameWithExtension entry.path)
                            |> Array.keepIf (String.endsWith ".erl")
                            |> Array.sort
                            |> Array.map (\name -> Path.append (Path.fromPosixString name) thePlan.src)
                in
                spawn config
                    config.tools.erlc
                    "GENG_ERLC"
                    "--erlc"
                    (toolchainRefused config.tools.erlc)
                    ([ "-o", config.toString thePlan.ebin ]
                        ++ Array.map config.toString (sources ++ externs)
                    )
            )


{-| D384's escript, written by `packages/beam-backend/build/geng_escript.erl`, which
this compiler carries beside the runtime and writes out to run.

`escript` runs an `.erl` source directly, so there is nothing to compile first;
the file goes in the build's own directory rather than the output one, because
a build tool is not part of the program it builds.
-}
escript : Config -> Plan -> Task Report {}
escript config thePlan =
    let
        writer =
            Path.append (Path.fromPosixString Runtime.escriptWriter.name) thePlan.work
    in
    FileSystem.writeFile config.fs
        (Bytes.fromString Runtime.escriptWriter.text)
        writer
        |> Task.mapError (failure "I cannot write the escript builder")
        |> Task.andThen
            (\_ ->
                spawn config
                    config.tools.escript
                    "GENG_ESCRIPT"
                    "--escript"
                    (toolchainRefused config.tools.escript)
                    [ config.toString writer
                    , config.toString thePlan.escript
                    , config.toString thePlan.ebin
                    ]
            )


{-| One of the two programs, run with our own streams, and what to say when it
is not there.

The streams are ours because `erlc`'s diagnostics are the ones worth reading
when the backend emits Erlang it should not have — §BM21's `-file` attribute
makes them name a Geng line — and swallowing them to print them again would
only lose the colours.

**No shell**, which is what makes a missing program reach the message below.
Under one it is the shell that runs and exits 127, so a `geng make` on a
machine with no Erlang would report a defect in the backend instead of a
toolchain that is not installed — which is what it did until this was measured.
-}
spawn : Config -> String -> String -> String -> (Int -> Report) -> Array String -> Task Report {}
spawn config program envName flagName refused args =
    { (ChildProcess.defaultSpawnOptions ChildProcess.Integrated)
        | shell = ChildProcess.NoShell
        , environmentVariables =
            if Dict.isEmpty config.environment then
                ChildProcess.InheritEnvironmentVariables

            else
                ChildProcess.MergeWithEnvironmentVariables config.environment
    }
        |> ChildProcess.spawn config.cp program args
        |> Task.mapError
            (\err ->
                Report.create
                    "I CANNOT RUN THE BEAM TOOLCHAIN"
                    Nothing
                    (PP.verticalBlock
                        [ PP.words
                            ("A build for the beam target runs " ++ program ++ ", and I could not start it: " ++ err.errorCode ++ ".")
                        , PP.empty
                        , PP.words
                            ("Erlang is not part of this compiler. Put it on your PATH, or tell me where it is with "
                                ++ flagName
                                ++ "=PATH or the "
                                ++ envName
                                ++ " environment variable."
                            )
                        ]
                    )
            )
        |> Task.andThen ChildProcess.waitForExit
        |> Task.andThen
            (\exitCode ->
                if exitCode == 0 then
                    Task.succeed {}

                else
                    Task.fail (refused exitCode)
            )


{-| `erlc` or `escript` exited with a status that is not 0, having printed why. -}
toolchainRefused : String -> Int -> Report
toolchainRefused program exitCode =
    Report.create
        "THE BEAM TOOLCHAIN REFUSED THIS PROGRAM"
        Nothing
        (PP.verticalBlock
            [ PP.words
                (program
                    ++ " exited with status "
                    ++ String.fromInt exitCode
                    ++ ", and what it printed is above."
                )
            , PP.empty
            , PP.words "A build reaches this only once the backend has emitted every binding of your program, so what is left for it to refuse is a `src/Ext/*.erl` file of one of your packages, or a defect in the backend. An `erlang` extern row cannot be: the front end holds its module and its function to bare atoms, and the build holds each to a function that is there."
            ]
        )

read : FileSystem.Permission -> Path -> Task Report (Array Build.File)
read fs directory =
    FileSystem.listDirectory fs directory
        |> Task.mapError (failure "I cannot read the stage directory")
        |> Task.andThen
            (\entries ->
                entries
                    |> Array.map (\entry -> Path.filenameWithExtension entry.path)
                    |> Array.keepIf Build.isCore
                    |> Array.sort
                    |> Array.map
                        (\name ->
                            FileSystem.readFile fs (Path.append (Path.fromPosixString name) directory)
                                |> Task.mapError (failure "I cannot read the stage directory")
                                |> Task.map (\data -> { name = name, data = data })
                        )
                    |> Task.sequence
            )


failure : String -> FileSystem.Error -> Report
failure what error =
    Report.create
        "CANNOT BUILD FOR THE BEAM"
        Nothing
        (PP.verticalBlock
            [ PP.words (what ++ ":")
            , PP.empty
            , PP.words (FileSystem.errorToString error)
            ]
        )
