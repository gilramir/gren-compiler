module Terminal.Own exposing (check, checkerVariables, serve)

{-| The ownership checker (geng-lang `m4-own.md` §OW27, D963), run on every
build in its held run beside the refinement checker (D938), with each module's
check kept as a record so that a later build checks only what changed (§OW26).

The binary holds at the cut and writes `ownership/manifest` in the stage:
where the records are, and each module's record key and whether the record is
there (`Generate.ownStage`). The Core of each module with no record is beside
it, and only that is read and checked; the rest is read from its record. That
part runs on a worker thread with the backends' stack (`Terminal.BackendWorker`,
D645), since the checker and Core's reader recurse once a level of the Core,
and on node's own stack a record 1,000 deep is more than they reach.

What the check finds refuses the build: each of `Geng.Own.Error`'s errors, laid
out by `Terminal.Refine` beside the refinement checker's. `GENG_OWN_REPORT`
names a file the build's lines are appended to, in `Geng.Own.Check`'s columns:
a program whose suite builds it more than once writes each
build's. `GENG_OWN_ERRORS` names a file for the errors' text, without colour,
whether or not they refuse the build, which `harness/own.py` pins.
`GENG_UNCHECKED_OWNERSHIP` builds a program the check refuses anyway: a
development switch, as `GENG_UNCHECKED_REFINEMENTS` is (D825), so that the gate
can report on cases written to be refused.
-}

import Bytes
import Cli.PrettyPrinter as PP
import Cli.Report as Report exposing (Report)
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Geng.Core as Core
import Geng.Core.Wire as Wire
import Geng.Own.Check as Check
import Geng.Own.Error as Error
import Json.Decode as Decode
import Json.Encode as Encode
import Task exposing (Task)
import Terminal.BackendWorker as BackendWorker


{-| What the binary is told on every build: the script of the CLI that will
check, whose bytes are the checker's part of every record's key. With it, the
binary holds at the cut and stages what has no record (`Generate.ownStage`).
-}
checkerVariables : Dict String String -> String -> Dict String String
checkerVariables _ script =
    if script /= "" then
        Dict.singleton "GENG_OWN_CHECKER" script

    else
        Dict.empty


{-| The check of a build's modules, `dir` the stage: the worker checks them and
answers the lines, which are appended to `GENG_OWN_REPORT` when it names a file;
the answer is the violations, which the caller turns into errors and refuses
the build with unless `GENG_UNCHECKED_OWNERSHIP` is set.
-}
check : { c | fs : FileSystem.Permission, envVars : Dict String String, fromString : String -> Path, toString : Path -> String } -> Path -> Task Report (Array Error.Violation)
check config dir =
    let
        request =
            Encode.object
                [ { key = "target", value = Encode.string "own" }
                , { key = "stage", value = Encode.string (config.toString dir) }
                ]

        answered =
            Decode.oneOf
                [ Decode.field "lines" (Decode.array Decode.string) |> Decode.map Ok
                , Decode.map2 (\what why -> Err (report what why)) (Decode.field "failed" Decode.string) (Decode.field "why" Decode.string)
                ]
    in
    BackendWorker.call "ownership checker" request answered
        |> Task.andThen
            (\result ->
                when result is
                    Err stopped ->
                        Task.fail stopped

                    Ok lines ->
                        let
                            text =
                                lines
                                    |> Array.map (\line -> line ++ "\n")
                                    |> String.join ""
                        in
                        (when Dict.get "GENG_OWN_REPORT" config.envVars is
                            Just out ->
                                FileSystem.appendToFile config.fs (Bytes.fromString text) (config.fromString out)
                                    |> Task.map (\_ -> {})
                                    |> Task.mapError (\e -> report "I cannot write the ownership report" (FileSystem.errorToString e))

                            Nothing ->
                                Task.succeed {}
                        )
                            |> Task.map (\_ -> Array.mapAndKeepJust Error.parse lines)
            )


{-| The worker's part (D645): the stage's manifest read, the records it names
loaded, the modules staged without one decoded, every module checked, a record
written for each module checked, and the lines answered, in every module's
order whichever were records; or a failure, as `check` reads it.
-}
serve : FileSystem.Permission -> (String -> Path) -> Decode.Value -> Task Never String
serve fs fromString value =
    let
        config =
            { fs = fs, fromString = fromString }

        answer lines =
            Encode.encode 0 (Encode.object [ { key = "lines", value = Encode.array Encode.string lines } ])

        failed what why =
            Encode.encode 0 (Encode.object [ { key = "failed", value = Encode.string what }, { key = "why", value = Encode.string why } ])
    in
    when Decode.decodeValue (Decode.field "stage" Decode.string) value is
        Err e ->
            Task.succeed (failed "The ownership checker's request was not one it reads" (Decode.errorToString e))

        Ok staged ->
            let
                dir =
                    fromString staged

                stage =
                    Path.append (Path.fromPosixString "ownership") dir
            in
            readManifest config stage
                |> Task.andThen
                    (\manifest ->
                        Task.map2 (\records modules -> { records = records, modules = modules })
                            (loadRecords config manifest)
                            (readModules fs stage)
                            |> Task.andThen
                                (\read ->
                                    let
                                        done =
                                            Check.checkAll read.records read.modules
                                    in
                                    writeRecords config dir manifest done.records
                                        |> Task.map (\_ -> answer done.lines)
                                )
                    )
                |> Task.onError (\e -> Task.succeed (failed e.what e.why))


type alias Entry =
    { name : Core.ModuleName
    , key : Maybe String
    , present : Bool
    }


type alias Manifest =
    { records : Maybe Path
    , entries : Array Entry
    }


readManifest : { c | fs : FileSystem.Permission, fromString : String -> Path } -> Path -> Task Problem Manifest
readManifest config stage =
    FileSystem.readFile config.fs (Path.append (Path.fromPosixString "manifest") stage)
        |> Task.mapError (\e -> failure "I cannot read what the build staged for the ownership checker" (FileSystem.errorToString e))
        |> Task.andThen
            (\data ->
                let
                    rows =
                        Bytes.toString data
                            |> Maybe.withDefault ""
                            |> String.split "\n"
                            |> Array.keepIf (\l -> l /= "")
                            |> Array.map (String.split "\t")

                    records =
                        rows
                            |> Array.findFirst (\r -> Array.get 0 r == Just "records")
                            |> Maybe.andThen (\found -> Array.get 1 found.value)
                            |> Maybe.andThen
                                (\d ->
                                    if d == "" then
                                        Nothing

                                    else
                                        Just (config.fromString d)
                                )

                    entries =
                        Array.mapAndKeepJust
                            (\r ->
                                when r is
                                    [ package, module_, key, status ] ->
                                        Just
                                            { name = { package = package, module_ = module_ }
                                            , key =
                                                if key == "-" then
                                                    Nothing

                                                else
                                                    Just key
                                            , present = status == "present"
                                            }

                                    _ ->
                                        Nothing
                            )
                            rows
                in
                Task.succeed { records = records, entries = entries }
            )


{-| The record of every module the manifest says has one. -}
loadRecords : { c | fs : FileSystem.Permission } -> Manifest -> Task Problem (Array Check.Record)
loadRecords config manifest =
    when manifest.records is
        Nothing ->
            Task.succeed []

        Just recordDir ->
            manifest.entries
                |> Array.mapAndKeepJust
                    (\e ->
                        if e.present then
                            e.key

                        else
                            Nothing
                    )
                |> Array.map
                    (\key ->
                        let
                            at ext =
                                Path.append (Path.fromPosixString (key ++ ext)) recordDir

                            cannot e =
                                failure ("I cannot read the ownership record " ++ key) (FileSystem.errorToString e)
                        in
                        Task.map2 (\facts core -> { facts = facts, core = core })
                            (FileSystem.readFile config.fs (at ".facts") |> Task.mapError cannot)
                            (FileSystem.readFile config.fs (at ".corepb") |> Task.mapError cannot)
                            |> Task.andThen
                                (\found ->
                                    when Wire.read found.core is
                                        Err e ->
                                            Task.fail (failure ("I cannot read the ownership record " ++ key) (Wire.errorToString e))

                                        Ok declarations ->
                                            when Check.recordFromText (Bytes.toString found.facts |> Maybe.withDefault "") declarations is
                                                Ok record ->
                                                    Task.succeed record

                                                Err why ->
                                                    Task.fail (failure ("I cannot read the ownership record " ++ key) why)
                                )
                    )
                |> Task.sequence


{-| A record for every module checked now that has a key: its declarations'
Core first, then its facts, each written beside its name and moved there, so
that a record whose facts are there is whole. Two builds writing one record
write the same bytes. -}
writeRecords : { c | fs : FileSystem.Permission } -> Path -> Manifest -> Array Check.Record -> Task Problem {}
writeRecords config dir manifest records =
    when manifest.records is
        Nothing ->
            Task.succeed {}

        Just recordDir ->
            let
                keys =
                    Array.foldl
                        (\e acc ->
                            when e.key is
                                Just key ->
                                    if e.present then
                                        acc

                                    else
                                        Dict.set (e.name.package ++ "\t" ++ e.name.module_) key acc

                                Nothing ->
                                    acc
                        )
                        Dict.empty
                        manifest.entries

                unique =
                    Path.filenameWithExtension dir

                cannot e =
                    failure "I cannot write an ownership record" (FileSystem.errorToString e)

                put name bytes =
                    let
                        final =
                            Path.append (Path.fromPosixString name) recordDir

                        temporary =
                            Path.append (Path.fromPosixString (name ++ "." ++ unique ++ ".tmp")) recordDir
                    in
                    FileSystem.writeFile config.fs bytes temporary
                        |> Task.andThen (\_ -> FileSystem.move config.fs final temporary)
                        |> Task.map (\_ -> {})
                        |> Task.mapError cannot

                one record =
                    when Dict.get (record.name.package ++ "\t" ++ record.name.module_) keys is
                        Nothing ->
                            Task.succeed {}

                        Just key ->
                            when Wire.write record.declarations is
                                Err why ->
                                    Task.fail (failure ("I cannot write the ownership record of " ++ record.name.module_) why)

                                Ok core ->
                                    put (key ++ ".corepb") core
                                        |> Task.andThen (\_ -> put (key ++ ".facts") (Bytes.fromString (Check.recordToText record)))
            in
            if Dict.isEmpty keys then
                Task.succeed {}

            else
                FileSystem.makeDirectory config.fs { recursive = True } recordDir
                    |> Task.mapError cannot
                    |> Task.andThen (\_ -> records |> Array.map one |> Task.sequence)
                    |> Task.map (\_ -> {})


readModules : FileSystem.Permission -> Path -> Task Problem (Array Core.Module)
readModules fs directory =
    let
        cannot e =
            failure "I cannot read the Core the build wrote" (FileSystem.errorToString e)
    in
    FileSystem.listDirectory fs directory
        |> Task.mapError cannot
        |> Task.andThen
            (\entries ->
                entries
                    |> Array.map (\entry -> Path.filenameWithExtension entry.path)
                    |> Array.keepIf (String.endsWith ".corepb")
                    |> Array.sort
                    |> Array.map
                        (\name ->
                            FileSystem.readFile fs (Path.append (Path.fromPosixString name) directory)
                                |> Task.mapError cannot
                                |> Task.andThen
                                    (\data ->
                                        when Wire.read data is
                                            Ok m ->
                                                Task.succeed m

                                            Err e ->
                                                Task.fail (failure ("I cannot read " ++ name) (Wire.errorToString e))
                                    )
                        )
                    |> Task.sequence
            )


{-| What went wrong on the worker, which is answered and made a report on the
main thread. -}
type alias Problem =
    { what : String
    , why : String
    }


failure : String -> String -> Problem
failure what why =
    { what = what, why = why }


report : String -> String -> Report
report what why =
    Report.create
        "CANNOT CHECK OWNERSHIP"
        Nothing
        (PP.verticalBlock
            [ PP.words (what ++ ":")
            , PP.empty
            , PP.words why
            ]
        )
