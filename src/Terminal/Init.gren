module Terminal.Init exposing
    ( Config
    , Error (..)
    , run
    , runNonInteractive
    , prettifyError
    )

import Cli.PrettyPrinter as PP
import ChildProcess
import Stream
import Stream.Log
import Task exposing (Task)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Bytes exposing (Bytes)
import Json.Encode as Json
import Compiler.Backend
import Compiler.Platform as Platform exposing (Platform)
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.Outline as Outline exposing (Outline)
import Compiler.License as License
import Compiler.Paths
import Terminal.Help
import Git
import SemanticVersion exposing (SemanticVersion)
import SemanticVersionRange
import Dict
import Meta
import Terminal.PackageInstall as PackageInstall
import Cli.Report as Report exposing (Report)


type alias Config =
    { stdout : Stream.Writable Bytes
    , stdin : Stream.Readable Bytes
    , fsPermission : FileSystem.Permission
    , cpPermission : ChildProcess.Permission
    , cacheRoot : Compiler.Paths.CacheRoot
    , corePath : Path
    , interactive : Bool
    , useColor : Bool
    , package : Bool
    , platform : Platform
    }


type Error
    = AlreadyInitialized
    | FileSystemFailure FileSystem.Error
    | PromptError Stream.Error
    | CouldNotRetrieveVersions { packageName : PackageName, error : Git.Error }
    | NoVersionFound PackageName
    | InstallError PackageInstall.PackageInstallError


run : Config -> Task Error {}
run config =
    let
        grenJsonExists =
            FileSystem.checkAccess config.fsPermission [] (Path.fromPosixString Outline.fileName)
                |> Task.andThen
                    (\_ ->
                        Task.succeed True
                    )
                |> Task.onError
                    (\err ->
                        if FileSystem.errorIsNoSuchFileOrDirectory err then
                            Task.succeed False

                        else
                            Task.fail (FileSystemFailure err)
                    )
    
    in
    grenJsonExists
        |> Task.andThen
            (\exists ->
                if exists then
                    Task.fail AlreadyInitialized

                else
                    Terminal.Help.confirm
                        { stdout = config.stdout
                        , stdin = config.stdin
                        , useColor = config.useColor
                        , interactive = config.interactive
                        , question =
                            PP.verticalBlock
                                [ PP.block
                                    [ PP.words "Hello! Geng projects always start with a"
                                    , PP.text " "
                                    , PP.color PP.Green (PP.text "geng.toml")
                                    , PP.text " "
                                    , PP.words "file."
                                    ]
                                , PP.words "I can create one for you."
                                , PP.empty
                                , PP.words "Would you like me to create a geng.toml file now?"
                                ]
                        , defaultValue = True
                        }
                        |> Task.mapError PromptError
            )
        |> Task.andThen
            (\confirmed ->
                if confirmed then
                    runNonInteractive config Path.empty
                        |> Task.map (\_ -> {})

                else
                    Stream.Log.line config.stdout "Ok, I won't do anything."
            )


runNonInteractive : Config -> Path -> Task Error Outline
runNonInteractive config projectPath =
    let
        deps =
            dependenciesForPlatform config.platform
    in
    deps
        |> Array.map
            (\packageName ->
                Git.fetchLatestVersion config.cpPermission packageName
                    |> Task.mapError
                        (\err ->
                            CouldNotRetrieveVersions { packageName = packageName, error = err }
                        )
                    |> Task.map
                        (\vsn ->
                            { name = packageName
                            , version = vsn
                            }
                        )
            )
        |> Task.concurrent
        |> Task.andThen (generateManifest config projectPath)


{-| The packages a new project starts with. `core` is not one of them: every
project has it and no manifest lists it (K7).
-}
dependenciesForPlatform : Platform -> Array PackageName
dependenciesForPlatform platform =
  when platform is
    Platform.Common ->
        []

    Platform.Browser ->
        [ PackageName.browser ]

    Platform.Node ->
        [ PackageName.node ]


{-| Write a new `geng.toml`, once its dependencies are known to resolve. Each
dependency is a range from its newest release to the next breaking one, since
the lower bound is the version a build uses.
-}
generateManifest : Config -> Path -> Array { name : PackageName, version : SemanticVersion } -> Task Error Outline
generateManifest config projectPath deps =
    let
        dependencies =
            Array.foldl
                (\{ name, version } dict ->
                    Dict.set (PackageName.toString name) (upToNextBreaking version) dict
                )
                Dict.empty
                deps

        compiler =
            SemanticVersionRange.compatibleWith Meta.version

        outline =
            if config.package then
                Outline.Pkg
                    { platform = config.platform
                    , name = PackageName.example
                    , summary = ""
                    , license = License.bsd3
                    , version = { major = 1, minor = 0, patch = 0 }
                    , exposedModules = Outline.ExposedArray []
                    , gengVersion = compiler
                    , dependencies = dependencies
                    , sources = Dict.empty
                    }

            else
                Outline.App
                    { platform = config.platform
                    , sourceDirectories = [ Path.fromPosixString "src" ]
                    , gengVersion = compiler
                    , dependencies = dependencies
                    , sources = Dict.empty
                    }
    in
    PackageInstall.run
        { stdout = config.stdout
        , stdin = config.stdin
        , fsPermission = config.fsPermission
        , cpPermission = config.cpPermission
        , cacheRoot = config.cacheRoot
        , corePath = config.corePath
        , interactive = config.interactive
        , useColor = config.useColor
        }
        { projectPath = projectPath
        , outline = outline
        }
        |> Task.mapError InstallError
        |> Task.andThen
            (\_ ->
                Path.append (Path.fromPosixString Outline.fileName) projectPath
                    |> FileSystem.writeFile config.fsPermission (Bytes.fromString (Outline.toToml outline))
                    |> Task.andThen
                        (\_ ->
                            Path.append (Path.fromPosixString "src") projectPath
                                |> FileSystem.makeDirectory config.fsPermission { recursive = False }
                        )
                    |> Task.mapError FileSystemFailure
                    |> Task.map (\_ -> outline)
            )


upToNextBreaking : SemanticVersion -> SemanticVersionRange.SemanticVersionRange
upToNextBreaking version =
    let
        upper =
            if version.major == 0 then
                { major = 0, minor = version.minor + 1, patch = 0 }

            else
                { major = version.major + 1, minor = 0, patch = 0 }
    in
    SemanticVersionRange.of version upper
        |> Maybe.withDefault (SemanticVersionRange.fromExact version)


prettifyError : Error -> Report
prettifyError err =
    when err is
        AlreadyInitialized ->
            Report.create
                "EXISTING PROJECT"
                Nothing
                (PP.verticalBlock
                    [ PP.words "You already have a geng.toml file, so there's nothing for me to initialize!"
                    , PP.empty
                    , PP.block
                        [ PP.text "Maybe "
                        , PP.color PP.Green (Terminal.Help.makeLink "init")
                        , PP.text " "
                        , PP.words "can help you figure out what to do next?"
                        ]
                    ]
                )

        FileSystemFailure fsErr ->
            Report.create
                "FILESYSTEM ERROR"
                (Just <| FileSystem.errorPath fsErr)
                (PP.verticalBlock
                    [ PP.words "An unexpected error occured when accessing the filesystem."
                    , PP.empty
                    , PP.words "The error provided by the operating system is:"
                    , PP.empty
                    , PP.words (FileSystem.errorToString fsErr)
                        |> PP.color PP.Red
                        |> PP.indent
                    , PP.empty
                    , PP.words "Verify that you have access to this path. If the error persist, consider submitting a bug report."
                    ]
                )

        PromptError streamError ->
            Report.create
                "STREAM ERROR"
                Nothing
                (PP.verticalBlock
                    [ PP.words "An unexpected error occured with either the standard output or standard input streams."
                    , PP.empty
                    , PP.words "The error is:"
                    , PP.empty
                    , PP.words (Stream.errorToString streamError)
                        |> PP.color PP.Red
                        |> PP.indent
                    , PP.empty
                    , PP.words "This is most likely a bug. Consider submitting a bug report."
                    ]
                )

        CouldNotRetrieveVersions { packageName, error } ->
            Git.report
                "FAILED TO LOAD DEPENDENCIES"
                ("I tried to find the latest compatible versions of the " ++ PackageName.toString packageName)
                error

        NoVersionFound packageName ->
            Report.create
                "FAILED TO LOAD DEPENDENCIES"
                Nothing
                (PP.verticalBlock
                    [ PP.words "I tried to find the latest compatible versions of the"
                    , PP.text " "
                    , PP.text (PackageName.toString packageName)
                        |> PP.color PP.Green
                    , PP.text " "
                    , PP.words "but failed to find any versions for that package!"
                    , PP.empty
                    , PP.words "This is most likely a bug. Consider submitting a bug report."
                    ]
                )

        InstallError installError ->
            PackageInstall.prettifyError installError
