module Terminal.PackageUninstall exposing
    ( Error (..)
    , run
    , prettifyError
    )


import Cli.PrettyPrinter as PP
import ChildProcess
import Compiler.PackageName as PackageName exposing (PackageName)
import Compiler.Paths
import Compiler.Outline as Outline exposing (Outline)
import Stream
import Stream.Log
import Task exposing (Task)
import Dict exposing (Dict)
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Bytes exposing (Bytes)
import SemanticVersion
import Terminal.Help as Help
import Terminal.PackageInstall
import Cli.Report as Report exposing (Report)


type alias Config =
    { fsPermission : FileSystem.Permission
    , cpPermission : ChildProcess.Permission
    , cacheRoot : Compiler.Paths.CacheRoot
    , corePath : Path
    , interactive : Bool
    , useColor : Bool
    , stdout : Stream.Writable Bytes
    , stdin : Stream.Readable Bytes
    }


type alias Options =
    { projectPath : Path
    , outline : Outline
    }


type Error
    = PackageNotInstalled
    | PackageInstallError Terminal.PackageInstall.PackageInstallError
    | PromptError Stream.Error
    | UserCancelled
    | OutlineWriteError FileSystem.Error
    | OutlineEditError String


{-| Remove a package from `[dependencies]`, and say which packages the project
stops being built with as a result, since what it was built with only because
of that package goes too.
-}
run : Config -> Options -> PackageName -> Task Error Terminal.PackageInstall.PackageResolution
run config { projectPath, outline } requestedPackage =
    let
        packageNameStr =
            PackageName.toString requestedPackage

        installConfig =
            { fsPermission = config.fsPermission
            , cpPermission = config.cpPermission
            , cacheRoot = config.cacheRoot
            , corePath = config.corePath
            , interactive = config.interactive
            , useColor = config.useColor
            , stdout = config.stdout
            , stdin = config.stdin
            }

        { dependencies, finalOutline } =
            when outline is
                Outline.App app ->
                    { dependencies = app.dependencies
                    , finalOutline = Outline.App { app | dependencies = Dict.remove packageNameStr app.dependencies }
                    }

                Outline.Pkg pkg ->
                    { dependencies = pkg.dependencies
                    , finalOutline = Outline.Pkg { pkg | dependencies = Dict.remove packageNameStr pkg.dependencies }
                    }
    in
    if not (Dict.member packageNameStr dependencies) then
        Task.fail PackageNotInstalled

    else
        Stream.Log.line config.stdout ("Removing " ++ packageNameStr)
            |> Task.andThen
                (\_ ->
                    Terminal.PackageInstall.resolve installConfig { projectPath = projectPath, outline = outline }
                        |> Task.mapError PackageInstallError
                )
            |> Task.andThen
                (\before ->
                    Terminal.PackageInstall.resolve installConfig { projectPath = projectPath, outline = finalOutline }
                        |> Task.mapError PackageInstallError
                        |> Task.map (\after -> { before = before, after = after })
                )
            |> Task.andThen
                (\{ before, after } ->
                    let
                        removed =
                            before.lock.packages
                                |> Array.keepIf
                                    (\entry ->
                                        not (Array.any (\kept -> kept.name == entry.name) after.lock.packages)
                                    )
                                |> Array.map (\entry -> PackageName.toString entry.name ++ " " ++ SemanticVersion.toString entry.version)
                    in
                    promptUpdateOutline config projectPath removed (Outline.removeDependency packageNameStr)
                        |> Task.andThen
                            (\{} ->
                                Terminal.PackageInstall.writeLock config.fsPermission after
                                    |> Task.mapError PackageInstallError
                            )
                        |> Task.map (\{} -> after)
                )


promptUpdateOutline : Config -> Path -> Array String -> (String -> Result String String) -> Task Error {}
promptUpdateOutline config projectPath removedPackages edit =
    let
        manifestPath =
            Path.append (Path.fromPosixString Outline.fileName) projectPath

        plan =
            PP.verticalBlock
                [ PP.words "The plan is to remove the following dependencies:"
                , PP.empty
                , removedPackages
                    |> Array.map PP.text
                    |> PP.verticalBlock
                    |> PP.indent
                , PP.empty
                , PP.words "Do you want me to update the geng.toml file accordingly?"
                ]
    in
    Help.confirm
        { stdout = config.stdout
        , stdin = config.stdin
        , useColor = config.useColor
        , interactive = config.interactive
        , question = plan
        , defaultValue = True
        }
        |> Task.mapError PromptError
        |> Task.andThen
            (\confirmed ->
                if confirmed then
                    FileSystem.readFile config.fsPermission manifestPath
                        |> Task.mapError OutlineWriteError

                else
                    Task.fail UserCancelled
            )
        |> Task.andThen
            (\bytes ->
                when edit (Maybe.withDefault "" (Bytes.toString bytes)) is
                    Ok newText ->
                        FileSystem.writeFile config.fsPermission (Bytes.fromString newText) manifestPath
                            |> Task.mapError OutlineWriteError
                            |> Task.map (\_ -> {})

                    Err message ->
                        Task.fail (OutlineEditError message)
            )


prettifyError : Error -> Report
prettifyError error =
    when error is
        PackageNotInstalled ->
            Report.create
                "PACKAGE NOT INSTALLED"
                Nothing
                (PP.verticalBlock
                    [ PP.words "The package you requested to uninstall is not in the dependencies of your geng.toml."
                    , PP.empty
                    , PP.words "Maybe there's a typo?"
                    ]
                )

        PackageInstallError installError ->
            Terminal.PackageInstall.prettifyError installError

        PromptError streamErr ->
            Report.create
                "FAILED TO COMMUNICATE WITH USER"
                Nothing
                (PP.verticalBlock
                    [ PP.words "I wanted to ask you a question, but something seems to be wrong with the stdin stream."
                    , PP.empty
                    , PP.words "The error is:"
                    , PP.empty
                    , PP.words (Stream.errorToString streamErr)
                        |> PP.indent
                    , PP.empty
                    , PP.words "This is most definetly a bug. Please report it."
                    ]
                )

        UserCancelled ->
            Report.empty

        OutlineWriteError fsErr ->
            Report.create
                "FAILED TO UPDATE OUTLINE"
                Nothing
                (PP.verticalBlock
                    [ PP.words "An error occured while I updating the geng.toml file."
                    , PP.empty
                    , PP.words "The error is:"
                    , PP.empty
                    , PP.words (FileSystem.errorToString fsErr)
                        |> PP.indent
                    ]
                )

        OutlineEditError message ->
            Report.create
                "FAILED TO UPDATE OUTLINE"
                (Just (Path.fromPosixString Outline.fileName))
                (PP.verticalBlock
                    [ PP.words "I could not edit the geng.toml file. The error is:"
                    , PP.empty
                    , PP.words message
                        |> PP.indent
                    ]
                )
